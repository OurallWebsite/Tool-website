---
import type {Tool} from '../catalog';import {ui,type Lang} from '../site';const {tool,lang}:{tool:Tool,lang:Lang}=Astro.props;const u=ui[lang];
---
<div class="calc" data-calculator data-tool={JSON.stringify(tool)}><div class="inputs">{tool.inputs.map(i=><label class="field"><span>{i.label}</span><input name={i.key} type={i.type||'number'} value={i.value} step={i.step||'any'} /></label>)}</div><div class="result"><span>{u.result}</span><output aria-live="polite">—</output><small>{tool.unit}</small><p class="privacy">{u.privacy}</p></div></div>
<script>
const gcd=(a:number,b:number):number=>b?gcd(b,a%b):Math.abs(a);const days=(a:string,b:string)=>Math.round((new Date(b).getTime()-new Date(a).getTime())/864e5);
function compute(op:string,v:any[],p:number[]){const n=v.map(Number),[a,b,c]=n;switch(op){case'convert':return a*p[0]/p[1];case'annuity':{const r=b/1200,N=c*12;return r?a*r*(1+r)**N/((1+r)**N-1):a/N}case'compound':return a*(1+b/1200)**(c*12);case'simpleInterest':return a*b/100*c;case'savingsGoal':{const r=b/1200,N=c*12;return r?a*r/((1+r)**N-1):a/N}case'roi':return(b-a)/a*100;case'discount':return a*(1-b/100);case'tip':return a*(1+b/100)/c;case'bmi':return a/(b/100)**2;case'bmr':return 10*a+6.25*b-5*c+5;case'tdee':return(10*a+6.25*b-5*c+5)*1.55;case'bodyFat':return 1.2*a+.23*b-16.2;case'idealWeight':return 22*(a/100)**2;case'water':return a*.033+b*.012;case'pace':return b/a;case'heartRate':return(220-a)*b/100;case'percentage':return a/100*b;case'percentChange':return(b-a)/a*100;case'average3':return(a+b+c)/3;case'ratio':{const g=gcd(a,b);return`${a/g}:${b/g}`}case'pythagorean':return Math.hypot(a,b);case'circleArea':return Math.PI*a*a;case'triangleArea':return a*b/2;case'sqrt':return Math.sqrt(a);case'age':{let y=new Date(v[1]).getFullYear()-new Date(v[0]).getFullYear();if(new Date(v[1]).setFullYear(2000)<new Date(v[0]).setFullYear(2000))y--;return y}case'dateDiff':return days(v[0],v[1]);case'addDays':{const d=new Date(v[0]);d.setDate(d.getDate()+b);return d.toISOString().slice(0,10)}case'businessDays':{let d=new Date(v[0]),e=new Date(v[1]),x=0;while(d<=e){if(d.getDay()>0&&d.getDay()<6)x++;d.setDate(d.getDate()+1)}return x}case'duration':return b-a;case'multiply':return a*p[0];case'area':return a*b;case'volume':return a*b*c*p[0];case'coverage':return Math.ceil(a/b);case'waste':return a*(1+b/100);case'slope':return a/b*100;case'margin':return(a-b)/a*100;case'markup':return(b-a)/a*100;case'breakEven':return Math.ceil(a/(b-c));case'cagr':return((b/a)**(1/c)-1)*100;case'divide':return a/b;case'multiply3':return a*b*c;case'percentagePair':return a/b*100;case'gpa':return a/b;case'weighted':return a*b/100;case'examNeeded':return(c? (b-a*(1-c/100))/(c/100):0);case'kinetic':return .5*a*b*b;default:return a*b}}
const fmt=(x:any)=>typeof x==='number'?(Number.isFinite(x)?new Intl.NumberFormat(undefined,{maximumFractionDigits:4}).format(x):'—'):x;
document.querySelectorAll<HTMLElement>('[data-calculator]').forEach(root=>{const tool=JSON.parse(root.dataset.tool!);const inputs=[...root.querySelectorAll<HTMLInputElement>('input')],out=root.querySelector('output')!;const run=()=>{const vals=inputs.map(i=>i.value);out.textContent=fmt(compute(tool.op,vals,tool.params))};inputs.forEach(i=>i.addEventListener('input',run));run()});
</script>
