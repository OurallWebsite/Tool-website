---
import type { Tool } from '../catalog';
import { ui, type Lang } from '../site';
import '../styles/tool-detail.css';
const { tool, lang }: { tool: Tool; lang: Lang } = Astro.props;
const u = ui[lang];
---
<section class="tool-workspace" data-calculator data-tool={JSON.stringify(tool)}>
  <div class="workspace-toolbar"><div><span class="live-dot"></span><strong>Live analysis</strong><small>Updates as you type</small></div><div class="tool-actions" aria-label="Calculator actions"><button type="button" class="action-btn" data-share>↗ <span>Share</span></button><button type="button" class="action-btn" data-copy>⧉ <span>Copy link</span></button><button type="button" class="action-btn" data-print>▣ <span>Print / PDF</span></button></div></div>
  <div class="calculator-stage">
    <div class="input-panel"><div class="panel-heading"><span class="step-number">01</span><div><strong>Your inputs</strong><small>Adjust any value to recalculate</small></div></div><div class="input-grid">{tool.inputs.map((input,index)=><label class="advanced-field"><span>{input.label}</span><div class="input-wrap"><input name={input.key} type={input.type||'number'} value={input.value} step={input.step||'any'} data-input-index={index}/>{tool.unit&&input.type!=='date'&&<small>{index===0?'Value':`Input ${index+1}`}</small>}</div></label>)}</div><p class="browser-note">🔒 {u.privacy} Nothing is uploaded or stored.</p></div>
    <aside class="result-panel"><span class="result-kicker">{u.result}</span><output aria-live="polite">—</output><strong class="result-unit">{tool.unit}</strong><span class="result-status" data-status>Live result</span><p data-interpretation>Enter your values to see a personalized interpretation.</p></aside>
  </div>
  <section class="analytics-zone" aria-labelledby="analytics-title">
    <div class="section-heading-row"><div><span class="eyebrow">Dynamic report</span><h2 id="analytics-title">Your calculation at a glance</h2></div><span class="calculation-stamp" data-stamp>Calculated now</span></div>
    <div class="metric-grid" data-metrics>{[0,1,2,3].map(index=><article class="metric-card"><span data-metric-label={index}>Metric {index+1}</span><strong data-metric-value={index}>—</strong><small data-metric-note={index}>Updates automatically</small></article>)}</div>
    <div class="visual-grid"><article class="analytics-card wide-card"><div class="analytics-card-head"><div><span class="eyebrow">Input profile</span><h3>Values and result</h3></div><span>Relative scale</span></div><div class="bar-chart" data-bars></div></article><article class="analytics-card score-card"><div class="analytics-card-head"><div><span class="eyebrow">Result signal</span><h3>Result balance</h3></div></div><div class="donut" data-donut style="--score:50"><div><strong data-score>50%</strong><small>relative signal</small></div></div><p data-score-copy>Result compared with supplied inputs.</p></article></div>
    <article class="analytics-card scenario-card"><div class="analytics-card-head"><div><span class="eyebrow">Sensitivity</span><h3>What-if scenarios</h3></div><span data-scenario-note>Primary input ±10%</span></div><div class="scenario-list" data-scenarios></div></article>
    <div class="guidance-grid"><article class="guidance-card"><span class="guidance-icon">◎</span><div><h3>What this result means</h3><p data-guidance>Results use the stated formula.</p></div></article><article class="guidance-card"><span class="guidance-icon">↗</span><div><h3>Recommended next steps</h3><ul data-tips></ul></div></article></div>
  </section><div class="copy-toast" role="status" aria-live="polite" data-toast hidden>Link copied</div>
</section>
<script>
const gcd=(a:number,b:number):number=>b?gcd(b,a%b):Math.abs(a);const dayDifference=(a:string,b:string)=>Math.round((new Date(b).getTime()-new Date(a).getTime())/864e5);
function compute(op:string,v:any[],p:number[]){const n=v.map(Number),[a,b,c]=n;switch(op){case'convert':return a*p[0]/p[1];case'annuity':{const r=b/1200,N=c*12;return r?a*r*(1+r)**N/((1+r)**N-1):a/N}case'compound':return a*(1+b/1200)**(c*12);case'simpleInterest':return a*b/100*c;case'savingsGoal':{const r=b/1200,N=c*12;return r?a*r/((1+r)**N-1):a/N}case'roi':return(b-a)/a*100;case'discount':return a*(1-b/100);case'tip':return a*(1+b/100)/c;case'bmi':return a/(b/100)**2;case'bmr':return 10*a+6.25*b-5*c+5;case'tdee':return(10*a+6.25*b-5*c+5)*1.55;case'bodyFat':return 1.2*a+.23*b-16.2;case'idealWeight':return 22*(a/100)**2;case'water':return a*.033+b*.012;case'pace':return b/a;case'heartRate':return(220-a)*b/100;case'percentage':return a/100*b;case'percentChange':return(b-a)/a*100;case'average3':return(a+b+c)/3;case'ratio':{const g=gcd(a,b);return`${a/g}:${b/g}`}case'pythagorean':return Math.hypot(a,b);case'circleArea':return Math.PI*a*a;case'triangleArea':return a*b/2;case'sqrt':return Math.sqrt(a);case'age':{let y=new Date(v[1]).getFullYear()-new Date(v[0]).getFullYear();if(new Date(v[1]).setFullYear(2000)<new Date(v[0]).setFullYear(2000))y--;return y}case'dateDiff':return dayDifference(v[0],v[1]);case'addDays':{const d=new Date(v[0]);d.setDate(d.getDate()+b);return d.toISOString().slice(0,10)}case'businessDays':{let d=new Date(v[0]),e=new Date(v[1]),x=0;while(d<=e){if(d.getDay()>0&&d.getDay()<6)x++;d.setDate(d.getDate()+1)}return x}case'duration':return b-a;case'multiply':return p.length?a*p[0]:a*b;case'area':return a*b;case'volume':return a*b*c*p[0];case'coverage':return Math.ceil(a/b);case'waste':return a*(1+b/100);case'slope':return a/b*100;case'margin':return(a-b)/a*100;case'markup':return(b-a)/a*100;case'breakEven':return Math.ceil(a/(b-c));case'cagr':return((b/a)**(1/c)-1)*100;case'divide':return a/b;case'multiply3':return a*b*c;case'percentagePair':return a/b*100;case'gpa':return a/b;case'weighted':return a*b/100;case'examNeeded':return c?(b-a*(1-c/100))/(c/100):0;case'kinetic':return.5*a*b*b;default:return a*b}}
const fmt=(x:any)=>typeof x==='number'?(Number.isFinite(x)?new Intl.NumberFormat(undefined,{maximumFractionDigits:4}).format(x):'—'):String(x??'—');
const tips:Record<string,string[]>={finance:['Compare realistic scenarios before deciding.','Include fees, taxes and timing.','Use conservative long-term assumptions.'],health:['Treat this as an educational estimate.','Use recent, accurate measurements.','Discuss concerns with a qualified clinician.'],math:['Keep units consistent.','Check signs, decimals and rounding.','Verify with the displayed formula.'],'date-time':['Confirm whether dates are inclusive.','Account for local holidays.','Check the relevant time zone.'],construction:['Add a practical waste allowance.','Verify site measurements.','Round purchases to package sizes.'],business:['Compare with your historical baseline.','Test best and worst cases.','Include indirect costs.'],education:['Confirm the official grading policy.','Model several score scenarios.','Use this as a planning aid.'],science:['Use compatible units.','Record measurement uncertainty.','Validate critical work independently.'],converters:['Confirm both units.','Keep extra decimal places.','Round only at the final step.']};
function statusFor(t:any,r:any){const x=Number(r);if(t.op==='bmi')return x<18.5?['Below reference range','attention']:x<25?['Within reference range','good']:x<30?['Above reference range','attention']:['Well above reference range','alert'];if(['roi','cagr','margin','markup','percentChange'].includes(t.op))return x>0?['Positive result','good']:x<0?['Negative result','alert']:['Neutral result','attention'];if(t.op==='examNeeded')return x<=100?['Target is achievable','good']:['Target exceeds 100%','alert'];if(t.op==='convert')return['Exact factor applied','good'];return Number.isFinite(x)?['Calculation complete','good']:['Check your inputs','alert']}
function interpretation(t:any,v:any[],r:any){const x=Number(r),a=Number(v[0]);switch(t.op){case'annuity':return`Estimated recurring payment: ${fmt(x)} ${t.unit||''}. Fees, insurance or taxes may increase the real cost.`;case'compound':return`Projected balance: ${fmt(x)} ${t.unit||''}, a change of ${fmt(x-a)} from the starting principal.`;case'bmi':return`A BMI of ${fmt(x)} is a screening estimate and does not directly measure body composition.`;case'discount':return`Discounted price: ${fmt(x)} ${t.unit||''}; estimated saving: ${fmt(a-x)}.`;case'tip':return`Each person pays about ${fmt(x)} ${t.unit||''} using the selected rate and party size.`;case'convert':return`${fmt(a)} in the source unit equals ${fmt(x)} ${t.unit||''}.`;case'age':return`Elapsed age: ${fmt(x)} complete calendar years.`;default:return`The calculated result is ${fmt(r)} ${t.unit||''}. Review the formula and assumptions below.`}}
function metrics(t:any,v:any[],r:any){const x=Number(r),a=Number(v[0]),b=Number(v[1]),c=Number(v[2]);if(t.op==='annuity'){const m=c*12,total=x*m;return[['Monthly payment',fmt(x),t.unit],['Annual payments',fmt(x*12),'12 payments'],['Total repaid',fmt(total),`${fmt(m)} payments`],['Financing cost',fmt(total-a),'Above principal']]}if(t.op==='compound')return[['Future value',fmt(x),t.unit],['Estimated gain',fmt(x-a),'Above principal'],['Total growth',`${fmt((x/a-1)*100)}%`,'Full term'],['Time horizon',`${fmt(c)} years`,'Monthly compounding']];if(t.op==='bmi')return[['BMI',fmt(x),t.unit],['Reference range','18.5–24.9','Adult screening'],['Weight entered',`${fmt(a)} kg`,'Current input'],['Height entered',`${fmt(b)} cm`,'Current input']];if(t.op==='convert')return[['Converted value',fmt(x),t.unit],['Source value',fmt(a),'Entered amount'],['Conversion factor',fmt(t.params[0]/t.params[1]),'Target per source'],['Inverse factor',fmt(t.params[1]/t.params[0]),'Source per target']];if(t.op==='discount')return[['Final price',fmt(x),t.unit],['You save',fmt(a-x),t.unit],['Discount rate',`${fmt(b)}%`,'Applied rate'],['You pay',`${fmt(x/a*100)}%`,'Of original']];if(t.op==='tip')return[['Per person',fmt(x),t.unit],['Tip amount',fmt(a*b/100),'Total tip'],['Bill with tip',fmt(a*(1+b/100)),'Party total'],['Party size',fmt(c),'People']];if(['roi','cagr','margin','markup','percentChange','percentagePair','slope'].includes(t.op))return[['Calculated rate',`${fmt(x)}%`,'Primary result'],['Starting value',fmt(a),t.inputs[0]?.label],['Comparison value',fmt(b),t.inputs[1]?.label],['Direction',x>=0?'Positive':'Negative','Relative change']];const nums=v.map(Number).filter(Number.isFinite),avg=nums.length?nums.reduce((s,z)=>s+z,0)/nums.length:0;return[['Calculated result',fmt(r),t.unit||'Output'],['Primary input',fmt(a),t.inputs[0]?.label],['Input average',fmt(avg),`${nums.length} numeric values`],['Result / input',a&&Number.isFinite(x)?`${fmt(x/a)}×`:'—','Relative magnitude']]}
document.querySelectorAll<HTMLElement>('[data-calculator]').forEach(root=>{const t=JSON.parse(root.dataset.tool||'{}'),inputs=[...root.querySelectorAll<HTMLInputElement>('input')],out=root.querySelector<HTMLOutputElement>('output')!,status=root.querySelector<HTMLElement>('[data-status]')!,toast=root.querySelector<HTMLElement>('[data-toast]')!;const show=(s:string)=>{toast.textContent=s;toast.hidden=false;setTimeout(()=>toast.hidden=true,2200)};root.querySelector('[data-share]')?.addEventListener('click',async()=>{const d={title:t.title,text:`${t.title}: ${out.textContent} ${t.unit||''}`,url:location.href};try{if(navigator.share)await navigator.share(d);else{await navigator.clipboard.writeText(location.href);show('Link copied — ready to share')}}catch{}});root.querySelector('[data-copy]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(location.href);show('Link copied to clipboard')});root.querySelector('[data-print]')?.addEventListener('click',()=>print());const render=()=>{const v=inputs.map(i=>i.value),r=compute(t.op,v,t.params||[]);out.textContent=fmt(r);const[s,c]=statusFor(t,r);status.textContent=s;status.className=`result-status ${c}`;root.querySelector<HTMLElement>('[data-interpretation]')!.textContent=interpretation(t,v,r);metrics(t,v,r).forEach((m:any[],i:number)=>{root.querySelector<HTMLElement>(`[data-metric-label="${i}"]`)!.textContent=m[0];root.querySelector<HTMLElement>(`[data-metric-value="${i}"]`)!.textContent=m[1];root.querySelector<HTMLElement>(`[data-metric-note="${i}"]`)!.textContent=m[2]||'Live metric'});const items=v.map((z,i)=>({label:t.inputs[i]?.label||`Input ${i+1}`,value:Number(z)})).filter(z=>Number.isFinite(z.value));if(typeof r==='number'&&Number.isFinite(r))items.push({label:'Result',value:r});const max=Math.max(...items.map(z=>Math.abs(z.value)),1);root.querySelector<HTMLElement>('[data-bars]')!.innerHTML=items.slice(0,6).map((z,i)=>`<div class="bar-row"><span>${z.label}</span><div><i style="width:${Math.max(4,Math.abs(z.value)/max*100)}%"></i></div><strong>${fmt(z.value)}</strong></div>`).join('');const total=items.slice(0,-1).reduce((s,z)=>s+Math.abs(z.value),0),rn=Number(r),score=Number.isFinite(rn)?Math.max(4,Math.min(96,Math.abs(rn)/(total+Math.abs(rn)||1)*100)):50;root.querySelector<HTMLElement>('[data-donut]')!.style.setProperty('--score',String(score));root.querySelector<HTMLElement>('[data-score]')!.textContent=`${Math.round(score)}%`;const ni=inputs.findIndex(i=>i.type!=='date'&&Number.isFinite(Number(i.value))),sc=root.querySelector<HTMLElement>('[data-scenarios]')!;if(ni>=0&&typeof r==='number'){const variants=[['Lower case',.9],['Current case',1],['Higher case',1.1]].map(([label,f]:any[])=>{const next=[...v];next[ni]=String(Number(next[ni])*f);return{label,f,result:Number(compute(t.op,next,t.params||[]))}}),sm=Math.max(...variants.map(z=>Math.abs(z.result)),1);sc.innerHTML=variants.map(z=>`<div class="scenario-row ${z.f===1?'current':''}"><span>${z.label}<small>${z.f===1?'Your inputs':`${z.f<1?'−':'+'}10% ${t.inputs[ni]?.label}`}</small></span><div><i style="width:${Math.max(5,Math.abs(z.result)/sm*100)}%"></i></div><strong>${fmt(z.result)} ${t.unit||''}</strong></div>`).join('')}else{root.querySelector<HTMLElement>('[data-scenario-note]')!.textContent='Date-based calculation';sc.innerHTML='<div class="scenario-empty">This result uses the exact calendar values entered above.</div>'}root.querySelector<HTMLElement>('[data-guidance]')!.textContent=interpretation(t,v,r);root.querySelector<HTMLElement>('[data-tips]')!.innerHTML=(tips[t.category]||tips.math).map(z=>`<li>${z}</li>`).join('');root.querySelector<HTMLElement>('[data-stamp]')!.textContent=`Updated ${new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}`};inputs.forEach(i=>i.addEventListener('input',render));render()});
</script>
