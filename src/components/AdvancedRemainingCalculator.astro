---
import type { Tool } from '../catalog';import type { Lang } from '../site';import '../styles/tool-detail.css';const {tool,lang}:{tool:Tool;lang:Lang}=Astro.props;
---
<section class="tool-workspace" data-remaining data-tool={JSON.stringify(tool)} data-lang={lang}><div class="workspace-toolbar"><div class="live-state"><span class="live-dot"></span><strong>Advanced scenario model</strong><small>Updates as you type</small></div><div class="tool-actions" role="group" aria-label="Calculator actions"><button class="action-btn" aria-label="Reset calculator" data-reset>↺ Reset</button><button class="action-btn" aria-label="Copy result" data-copy>⧉ Copy</button><button class="action-btn" aria-label="Share calculator" data-share>↗ Share</button><button class="action-btn" aria-label="Print calculator" data-print>▣ Print</button></div></div><div class="calculator-stage"><div class="input-panel"><div class="input-grid">{tool.inputs.map((x,i)=><label class="advanced-field"><span>{x.label}</span><div class="input-wrap"><input type="number" value={x.value} step={x.step||'any'} min={x.min} max={x.max} inputmode="decimal" data-i={i} required/><small>{x.help||'Use a value matching the stated unit.'}</small></div><em data-e={i}></em></label>)}</div></div><aside class="result-panel"><span class="result-kicker">Primary result</span><output>—</output><strong data-unit></strong><p data-note></p></aside></div><section class="analytics-zone"><div class="metric-grid">{[0,1,2,3].map(i=><article class="metric-card"><span data-l={i}></span><strong data-v={i}>—</strong><small data-n={i}></small></article>)}</div><article class="analytics-card scenario-card"><h3>Input sensitivity</h3><div class="scenario-list" data-scenarios></div></article><article class="analytics-card"><h3>Method and limitation</h3><p data-method></p></article></section></section>
<script>
type M=[string,string,string];type R={p:number;u:string;note:string;method:string;m:M[]};const f=(x:number,d=2)=>Number.isFinite(x)?new Intl.NumberFormat(undefined,{maximumFractionDigits:d}).format(x):'—';
function run(s:string,v:number[]):R{let p=0,u='',note='',method='',m:M[]=[];if(s==='paint-calculator'){const[a,c]=v,g=a/c;p=g;u='gallons';note=`Buy at least ${Math.ceil(g)} one-gallon containers for one coat.`;method='Uses entered paintable area and coverage for one coat. Multiply area by coat count before entry for multiple coats; texture and application loss vary.';m=[['Exact paint',`${f(g,3)} gal`,'Area ÷ coverage'],['Whole containers',f(Math.ceil(g),0),'Rounded up'],['Unused allowance',`${f(Math.ceil(g)-g,3)} gal`,'Container remainder'],['Coverage',`${f(c)} ft²/gal`,'Manufacturer input']]}
else if(s==='brick-calculator'){const[a,b]=v,count=a/b;p=Math.ceil(count);u='bricks';note=`Order at least ${Math.ceil(count)} bricks before adding project-specific waste.`;method='Wall area divided by nominal face area per brick. Openings, mortar joints, cuts and waste must be adjusted in the inputs or purchase plan.';m=[['Exact count',f(count,2),'Area ÷ brick area'],['Whole bricks',f(Math.ceil(count),0),'Rounded up'],['Wall area',`${f(a)} ft²`,'Entered'],['Brick face area',`${f(b,4)} ft²`,'Entered']]}
else if(s==='roof-pitch-calculator'){const[rise,runv]=v,ratio=rise/runv,deg=Math.atan(ratio)*180/Math.PI,mult=Math.sqrt(1+ratio*ratio);p=ratio*100;u='% slope';note=`Pitch is ${f(rise/runv*12,2)}:12 or ${f(deg,2)}°.`;method='Straight rafter geometry only; roof area still requires plan area, overhangs, hips, valleys and waste.';m=[['Slope',`${f(p,2)}%`,'Rise ÷ run'],['Pitch',`${f(ratio*12,2)}:12`,'Normalized'],['Angle',`${f(deg,2)}°`,'arctan(rise/run)'],['Roof multiplier',f(mult,4),'√(1+slope²)']]}
else if(s==='markup-calculator'){const[c,price]=v,profit=price-c,markup=profit/c*100,margin=profit/price*100;p=markup;u='% markup';note=`Profit per unit is ${f(profit)}; margin is ${f(margin)}%.`;method='Markup uses cost as denominator; margin uses selling price. They are not interchangeable.';m=[['Markup',`${f(markup)}%`,'Profit ÷ cost'],['Margin',`${f(margin)}%`,'Profit ÷ price'],['Profit/unit',f(profit),'Price − cost'],['Price multiplier',f(price/c,3),'Price ÷ cost']]}
else if(s==='cagr-calculator'){const[start,end,years]=v,multiple=end/start,total=(multiple-1)*100,rate=(multiple**(1/years)-1)*100,direction=total>0?'grew':total<0?'declined':'was unchanged';p=rate;u='% CAGR';note=`Value ${direction} ${f(Math.abs(total))}% overall; the smoothed annual rate is ${f(rate,3)}%.`;method='CAGR = (ending value ÷ beginning value)^(1 ÷ years) − 1. It summarizes the start-to-end path and does not show volatility, interim cash flows, fees, taxes or inflation.';m=[['CAGR',`${f(rate,3)}%`,'Annualized'],['Total growth',`${f(total,3)}%`,'End ÷ start − 1'],['Ending multiple',`${f(multiple,3)}×`,'End ÷ start'],['Absolute change',f(end-start),'End − start']]}
else if(s==='customer-acquisition-cost-calculator'){const[spend,customers]=v,valid=spend>=0&&customers>0,cac=valid?spend/customers:NaN,efficiency=valid&&spend>0?customers/spend*1000:NaN;p=cac;u='per customer';note=valid?`Acquisition cost is ${f(cac)} per new customer.`:'Enter at least one new customer acquired in the same period as the spend.';method='CAC = total sales and marketing costs ÷ new customers acquired. Keep the numerator, customer definition and measurement window consistent; channel attribution and blended versus paid CAC can change the result.';m=[['CAC',f(cac),'Spend ÷ customers'],['Total acquisition spend',f(spend),'Marketing + sales'],['New customers',f(customers,0),'Same measurement period'],['Customers per $1,000',f(efficiency,2),'Efficiency view']]}
else if(s==='customer-lifetime-value-calculator'){const[order,freq,years,margin]=v,annual=order*freq,lifetimeRevenue=annual*years,profitClv=lifetimeRevenue*(margin/100);p=lifetimeRevenue;u='lifetime revenue';note=`Modeled lifetime revenue is ${f(lifetimeRevenue)}; at ${f(margin,1)}% gross margin, estimated lifetime profit is ${f(profitClv)}.`;method='Revenue CLV = average order value × purchases per year × customer lifespan. A margin-adjusted profit CLV multiplies that revenue estimate by gross margin; retention, discounting, acquisition cost and cost-to-serve are not modeled.';m=[['Lifetime revenue',f(lifetimeRevenue),'Order × frequency × years'],['Estimated lifetime profit',f(profitClv),'Revenue × gross margin'],['Annual revenue',f(annual),'Order × frequency'],['Lifetime orders',f(freq*years,1),'Frequency × years']] }
else if(s==='conversion-rate-calculator'){const[c,vst]=v,valid=c>=0&&vst>0&&c<=vst,rate=valid?c/vst*100:NaN,nonConverting=valid?vst-c:NaN,visitorsPerConversion=valid&&c>0?vst/c:NaN;p=rate;u='% conversion';note=valid?`${f(c,0)} conversions from ${f(vst,0)} visitors.`:c>vst?'Conversions cannot exceed visitors in this visitor-based model.':'Enter at least one visitor to calculate a rate.';method='Conversion rate = conversions ÷ visitors × 100. Use the same date range, conversion definition and denominator; user, session, order and event rates can differ, and channel or device segmentation may reveal the actionable pattern.';m=[['Conversion rate',`${f(rate,3)}%`,'Conversions ÷ visitors'],['Non-converting visitors',f(nonConverting,0),'Visitors − conversions'],['Visitors/conversion',f(visitorsPerConversion,2),'Inverse rate'],['Per 1,000 visitors',f(rate*10,2),'Expected conversions']]}
else{const[cogs,inventory]=v,turns=cogs/inventory,days=365/turns;p=turns;u='turns/year';note=`Average inventory is replaced about every ${f(days,1)} days.`;method='COGS and average inventory must cover the same period; seasonality can make a simple average misleading.';m=[['Turnover',`${f(turns,2)}×`,'COGS ÷ inventory'],['Days inventory',f(days,1),'365 ÷ turns'],['Monthly turns',f(turns/12,3),'Annual ÷ 12'],['Inventory share',`${f(inventory/cogs*100,2)}%`,'Inventory ÷ COGS']]};return{p,u,note,method,m}}
document.querySelectorAll<HTMLElement>('[data-remaining]').forEach(root=>{const t=JSON.parse(root.dataset.tool||'{}'),ins=[...root.querySelectorAll<HTMLInputElement>('input')],defs=ins.map(i=>i.defaultValue),out=root.querySelector<HTMLOutputElement>('output')!;const shareUrl=()=>{const url=new URL(location.href);ins.forEach((input,i)=>url.searchParams.set(`v${i}`,input.value));return url.toString()};const render=()=>{let valid=true;ins.forEach((input,i)=>{const error=input.value===''?'Enter a value.':input.validity.rangeUnderflow?`Minimum is ${input.min}.`:input.validity.rangeOverflow?`Maximum is ${input.max}.`:input.validity.stepMismatch?`Use increments of ${input.step}.`:'';input.setAttribute('aria-invalid',error?'true':'false');root.querySelector<HTMLElement>(`[data-e="${i}"]`)!.textContent=error;if(error)valid=false});if(!valid){out.textContent='—';root.querySelector<HTMLElement>('[data-note]')!.textContent='Check inputs to continue.';root.querySelector<HTMLElement>('[data-method]')!.textContent='Correct the highlighted inputs to see a valid estimate.';return}const v=ins.map(i=>Number(i.value)),r=run(t.slug,v);out.textContent=f(r.p,3);root.querySelector<HTMLElement>('[data-unit]')!.textContent=r.u;root.querySelector<HTMLElement>('[data-note]')!.textContent=r.note;root.querySelector<HTMLElement>('[data-method]')!.textContent=r.method;r.m.forEach((x,i)=>{root.querySelector<HTMLElement>(`[data-l="${i}"]`)!.textContent=x[0];root.querySelector<HTMLElement>(`[data-v="${i}"]`)!.textContent=x[1];root.querySelector<HTMLElement>(`[data-n="${i}"]`)!.textContent=x[2]});root.querySelector<HTMLElement>('[data-scenarios]')!.innerHTML=[.9,1,1.1].map(x=>{const z=[...v];z[0]*=x;const q=run(t.slug,z);return`<div class="scenario-row ${x===1?'current':''}"><span>${x===1?'Current':x<1?'−10% first input':'+10% first input'}</span><strong>${f(q.p,3)} ${q.u}</strong></div>`}).join('')};const params=new URLSearchParams(location.search);ins.forEach((input,i)=>{const saved=params.get(`v${i}`);if(saved!==null)input.value=saved});ins.forEach(i=>i.addEventListener('input',render));root.querySelector('[data-reset]')?.addEventListener('click',()=>{ins.forEach((i,x)=>i.value=defs[x]);history.replaceState({},'',location.pathname);render()});root.querySelector('[data-copy]')?.addEventListener('click',()=>navigator.clipboard.writeText(`${t.title}: ${out.textContent}\n${shareUrl()}`));root.querySelector('[data-share]')?.addEventListener('click',async()=>{try{if(navigator.share)await navigator.share({title:t.title,text:`${t.title}: ${out.textContent}`,url:shareUrl()});else await navigator.clipboard.writeText(shareUrl())}catch{}});root.querySelector('[data-print]')?.addEventListener('click',()=>print());render()});
</script>
