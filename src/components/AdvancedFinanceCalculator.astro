---
import type { Tool } from '../catalog';
import type { Lang } from '../site';
import '../styles/tool-detail.css';
import '../styles/calculator-preferences.css';
const { tool, lang }: { tool: Tool; lang: Lang } = Astro.props;
const currencies = [
  ['USD','$','US dollar'],['EUR','€','Euro'],['GBP','£','British pound'],['INR','₹','Indian rupee'],
  ['AED','د.إ','UAE dirham'],['AUD','A$','Australian dollar'],['CAD','C$','Canadian dollar'],['JPY','¥','Japanese yen'],
  ['CNY','¥','Chinese yuan'],['BRL','R$','Brazilian real'],['MXN','MX$','Mexican peso'],['SGD','S$','Singapore dollar'],
  ['CHF','CHF','Swiss franc'],['ZAR','R','South African rand'],['NGN','₦','Nigerian naira'],['PKR','₨','Pakistani rupee'],
];
---
<section class="tool-workspace" data-advanced-finance data-tool={JSON.stringify(tool)} data-lang={lang}>
  <div class="workspace-toolbar"><div class="live-state"><span class="live-dot"></span><strong>Advanced finance model</strong><small>Updates as you type</small></div><div class="tool-actions" role="group" aria-label="Calculator actions"><button type="button" class="action-btn" aria-label="Reset calculator" data-reset>↺ <span>Reset</span></button><button type="button" class="action-btn" aria-label="Share calculator" data-share>↗ <span>Share</span></button><button type="button" class="action-btn" aria-label="Copy result" data-copy>⧉ <span>Copy</span></button><button type="button" class="action-btn" aria-label="Print calculator" data-print>▣ <span>Print / PDF</span></button></div></div>
  <div class="preference-bar"><label for={`advanced-currency-${tool.slug}`}><span>Display currency</span><select id={`advanced-currency-${tool.slug}`} data-currency>{currencies.map(([code,symbol,name])=><option value={code}>{symbol} {code} — {name}</option>)}</select></label><p><strong>Denomination only:</strong> symbols and number formatting change; values are not converted using live exchange rates.</p></div>
  <div class="calculator-stage"><div class="input-panel"><div class="panel-heading"><span class="step-number">01</span><div><strong>Planning assumptions</strong><small>Use realistic values for your scenario</small></div></div><div class="input-grid">{tool.inputs.map((input,index)=><label class="advanced-field"><span>{input.label}</span><div class="input-wrap"><input name={input.key} type="number" value={input.value} step={input.step||'any'} min={input.min} max={input.max} inputmode="decimal" required data-input-index={index} aria-describedby={`advanced-help-${tool.slug}-${index}`}/><small id={`advanced-help-${tool.slug}-${index}`}>{input.help}</small></div><em data-error={index}></em></label>)}</div><p class="browser-note">🔒 Calculations run locally in your browser. Nothing is uploaded.</p></div><aside class="result-panel"><span class="result-kicker">Primary result</span><output aria-live="polite">—</output><strong class="result-unit" data-unit>per month</strong><span class="result-status good">Advanced model ready</span><p data-interpretation>Adjust the assumptions to create your report.</p></aside></div>
  <section class="analytics-zone"><div class="section-heading-row"><div><span class="eyebrow">Detailed report</span><h2>Financial result breakdown</h2></div><span class="calculation-stamp" data-stamp>Calculated now</span></div><div class="metric-grid">{[0,1,2,3].map(index=><article class="metric-card"><span data-metric-label={index}>Metric</span><strong data-metric-value={index}>—</strong><small data-metric-note={index}>Live estimate</small></article>)}</div><div class="visual-grid"><article class="analytics-card wide-card"><div class="analytics-card-head"><div><span class="eyebrow">Cost composition</span><h3>Calculation breakdown</h3></div></div><div class="scenario-list" data-breakdown></div></article><article class="analytics-card score-card"><div class="analytics-card-head"><div><span class="eyebrow">Model note</span><h3>How to use this result</h3></div></div><p data-model-note>Compare the output with real offers and verified costs.</p></article></div><article class="analytics-card scenario-card"><div class="analytics-card-head"><div><span class="eyebrow">Sensitivity</span><h3>Primary-input scenarios</h3></div><span>−10%, current, +10%</span></div><div class="scenario-list" data-scenarios></div></article>
    <article class="analytics-card scenario-card" data-amortization-card hidden><div class="analytics-card-head"><div><span class="eyebrow">Payoff analysis</span><h3>Extra-payment comparison</h3></div><span>Principal and interest only</span></div><div class="metric-grid compact-metrics" data-comparison></div><div class="amortization-table-wrap"><table class="amortization-table"><thead><tr><th>Year</th><th>Principal paid</th><th>Interest paid</th><th>Ending balance</th></tr></thead><tbody data-amortization></tbody></table></div><p class="chart-note">The schedule groups monthly principal-and-interest calculations by loan year. Taxes, insurance, HOA, PMI and fees are not amortized in this table.</p></article>
  </section><div class="copy-toast" role="status" aria-live="polite" data-toast hidden>Copied</div>
</section>
<style>.amortization-table-wrap{margin-top:18px;overflow-x:auto}.amortization-table{width:100%;border-collapse:collapse;font-size:.82rem}.amortization-table th,.amortization-table td{padding:10px 12px;border-bottom:1px solid #e2e7e3;text-align:right;white-space:nowrap}.amortization-table th:first-child,.amortization-table td:first-child{text-align:left}.amortization-table th{color:#52615a;font-size:.72rem;text-transform:uppercase}.compact-metrics{margin-top:16px}</style>
<script>
type Row=[string,number|string,string];type ScheduleRow={year:number;principal:number;interest:number;balance:number};type Payoff={months:number;interest:number;rows:ScheduleRow[]};type Comparison={baselineMonths:number;actualMonths:number;monthsSaved:number;baselineInterest:number;actualInterest:number;interestSaved:number};type Model={primary:number;unit:string;interpretation:string;note:string;metrics:Row[];breakdown:Array<[string,number]>;schedule?:ScheduleRow[];comparison?:Comparison};
const locales:Record<string,string>={USD:'en-US',EUR:'de-DE',GBP:'en-GB',INR:'en-IN',AED:'ar-AE',AUD:'en-AU',CAD:'en-CA',JPY:'ja-JP',CNY:'zh-CN',BRL:'pt-BR',MXN:'es-MX',SGD:'en-SG',CHF:'de-CH',ZAR:'en-ZA',NGN:'en-NG',PKR:'en-PK'};
const payment=(principal:number,annualRate:number,months:number)=>{const r=annualRate/1200;return r?principal*r*(1+r)**months/((1+r)**months-1):principal/months};
const amortize=(principal:number,annualRate:number,scheduled:number,extra=0):Payoff=>{const r=annualRate/1200;let balance=principal,interest=0,months=0,yearPrincipal=0,yearInterest=0;const rows:ScheduleRow[]=[];while(balance>.005&&months<1200){const charge=balance*r,pay=Math.min(balance+charge,scheduled+extra);if(pay<=charge)return{months:Infinity,interest:Infinity,rows};const principalPaid=pay-charge;interest+=charge;yearInterest+=charge;yearPrincipal+=principalPaid;balance-=principalPaid;months++;if(months%12===0||balance<=.005){rows.push({year:Math.ceil(months/12),principal:yearPrincipal,interest:yearInterest,balance:Math.max(0,balance)});yearPrincipal=0;yearInterest=0}}return{months,interest,rows}};
const monthsToBalance=(principal:number,annualRate:number,scheduled:number,extra:number,target:number)=>{const r=annualRate/1200;let balance=principal,months=0;while(balance>target+.005&&months<1200){const charge=balance*r,pay=Math.min(balance+charge,scheduled+extra);if(pay<=charge)return Infinity;balance-=pay-charge;months++}return months};
const compare=(baseline:Payoff,actual:Payoff):Comparison=>({baselineMonths:baseline.months,actualMonths:actual.months,monthsSaved:Math.max(0,baseline.months-actual.months),baselineInterest:baseline.interest,actualInterest:actual.interest,interestSaved:Math.max(0,baseline.interest-actual.interest)});
const monthlyRate=(annualRate:number,periods:number)=>Math.pow(1+annualRate/100/periods,periods/12)-1;
function calculate(op:string,v:number[]):Model{if(op==='mortgageAdvanced'){const[price,down,rate,years,tax,insurance,hoa,pmiRate,extra]=v,principal=Math.max(0,price-down),scheduled=payment(principal,rate,Math.round(years*12)),pmi=price&&down/price<.2?principal*pmiRate/1200:0,baseline=amortize(principal,rate,scheduled,0),payoff=amortize(principal,rate,scheduled,extra),pmiMonths=pmi?monthsToBalance(principal,rate,scheduled,extra,price*.8):0,other=tax/12+insurance/12+hoa+pmi,primary=scheduled+other+extra;return{primary,unit:'per month',interpretation:'The estimate combines principal and interest with entered recurring housing costs. The payoff table models principal, interest and extra principal.',note:'PMI is an opening monthly estimate. The duration estimate assumes cancellation near 20% original-value equity, but lender rules, appraisal and loan type can differ.',metrics:[['All-in monthly',primary,'Including entered costs'],['Principal & interest',scheduled,'Scheduled payment'],['Estimated PMI period',pmi?Number.isFinite(pmiMonths)?`${pmiMonths} months`:'Not reached':'None','Assumes 20% equity threshold'],['Total interest',Number.isFinite(payoff.interest)?payoff.interest:'—','Principal-and-interest model']],breakdown:[['Principal & interest',scheduled],['Property tax',tax/12],['Home insurance',insurance/12],['HOA',hoa],['Estimated PMI',pmi],['Extra principal',extra]],schedule:payoff.rows,comparison:compare(baseline,payoff)}}
if(op==='loanAdvanced'){const[principal,rate,years,feeRate,extra]=v,scheduled=payment(principal,rate,Math.round(years*12)),fee=principal*feeRate/100,baseline=amortize(principal,rate,scheduled,0),payoff=amortize(principal,rate,scheduled,extra),primary=scheduled+extra,totalCost=payoff.interest+fee;return{primary,unit:'per month',interpretation:'The result is the scheduled installment plus optional extra principal. The table shows the modeled balance by loan year.',note:'Compare this modeled cost with a lender APR disclosure; late charges and optional products are not included.',metrics:[['Monthly payment',primary,'Including extra'],['Scheduled payment',scheduled,'Before extra'],['Payoff time',Number.isFinite(payoff.months)?`${payoff.months} months`:'Not payable','Modeled'],['Borrowing cost',Number.isFinite(totalCost)?totalCost:'—','Interest + upfront fee']],breakdown:[['Scheduled payment',scheduled],['Extra principal',extra],['Upfront fee',fee],['Modeled interest',payoff.interest]],schedule:payoff.rows,comparison:compare(baseline,payoff)}}
if(op==='compoundAdvanced'){const[principal,monthly,rate,years,periods]=v,months=Math.max(1,Math.round(years*12)),mr=monthlyRate(rate,periods),factor=(1+mr)**months,future=principal*factor+monthly*(mr?(factor-1)/mr:months),contributed=principal+monthly*months,growth=future-contributed,effective=(1+rate/100/periods)**periods-1;return{primary:future,unit:'future value',interpretation:'The future value combines the starting principal, end-of-month contributions and modeled compound growth.',note:'Returns are hypothetical and exclude taxes, fees, inflation and market volatility.',metrics:[['Future value',future,'Projected balance'],['Total contributed',contributed,'Principal + deposits'],['Investment growth',growth,'Modeled return'],['Effective annual yield',`${(effective*100).toFixed(2)}%`,'From frequency']],breakdown:[['Starting principal',principal],['Monthly deposits',monthly*months],['Modeled growth',growth]]}}
const[goal,current,rate,years,periods]=v,months=Math.max(1,Math.round(years*12)),mr=monthlyRate(rate,periods),factor=(1+mr)**months,currentFuture=current*factor,gap=Math.max(0,goal-currentFuture),accumulation=mr?(factor-1)/mr:months,required=gap/accumulation,totalDeposits=current+required*months,growth=goal-totalDeposits;return{primary:required,unit:'per month',interpretation:required<=0?'Current savings are projected to meet the goal without additional monthly deposits.':'Deposit this amount at the end of each month to reach the goal under the stated assumptions.',note:'The required amount changes if returns, timing, fees, taxes or the goal date differ.',metrics:[['Required monthly',required,'End-of-month deposit'],['Goal amount',goal,'Target balance'],['Current savings at goal',currentFuture,'Without new deposits'],['Modeled growth',growth,'Goal less deposits']],breakdown:[['Current savings',current],['Future monthly deposits',required*months],['Modeled growth',growth]]}}
document.querySelectorAll<HTMLElement>('[data-advanced-finance]').forEach(root=>{const tool=JSON.parse(root.dataset.tool||'{}'),inputs=[...root.querySelectorAll<HTMLInputElement>('input[data-input-index]')],defaults=inputs.map(input=>input.defaultValue),currency=root.querySelector<HTMLSelectElement>('[data-currency]')!,output=root.querySelector<HTMLOutputElement>('output')!,toast=root.querySelector<HTMLElement>('[data-toast]')!;let code=new URLSearchParams(location.search).get('currency')||localStorage.getItem('calcwise:currency')||'USD';if([...currency.options].some(option=>option.value===code))currency.value=code;else code='USD';const money=(value:number)=>new Intl.NumberFormat(locales[code]||'en-US',{style:'currency',currency:code,maximumFractionDigits:2}).format(value);const duration=(months:number)=>Number.isFinite(months)?`${Math.floor(months/12)}y ${months%12}m`:'—';const show=(text:string)=>{toast.textContent=text;toast.hidden=false;setTimeout(()=>toast.hidden=true,2000)};const shareUrl=()=>{const url=new URL(location.href);inputs.forEach((input,index)=>url.searchParams.set(`v${index}`,input.value));url.searchParams.set('currency',code);return url.toString()};const validate=()=>{let valid=true;inputs.forEach((input,index)=>{let message='';if(input.value==='')message='Enter a value.';else if(!Number.isFinite(Number(input.value)))message='Enter a valid number.';else if(input.validity.rangeUnderflow)message=`Minimum is ${input.min}.`;else if(input.validity.rangeOverflow)message=`Maximum is ${input.max}.`;input.setAttribute('aria-invalid',message?'true':'false');root.querySelector<HTMLElement>(`[data-error="${index}"]`)!.textContent=message;if(message)valid=false});return valid};const render=()=>{if(!validate()){output.textContent='—';return}const values=inputs.map(input=>Number(input.value)),model=calculate(tool.op,values);output.textContent=money(model.primary);root.querySelector<HTMLElement>('[data-unit]')!.textContent=`${code} ${model.unit}`;root.querySelector<HTMLElement>('[data-interpretation]')!.textContent=model.interpretation;root.querySelector<HTMLElement>('[data-model-note]')!.textContent=model.note;model.metrics.forEach((row,index)=>{root.querySelector<HTMLElement>(`[data-metric-label="${index}"]`)!.textContent=row[0];root.querySelector<HTMLElement>(`[data-metric-value="${index}"]`)!.textContent=typeof row[1]==='number'?money(row[1]):row[1];root.querySelector<HTMLElement>(`[data-metric-note="${index}"]`)!.textContent=row[2]});root.querySelector<HTMLElement>('[data-breakdown]')!.innerHTML=model.breakdown.map(([label,value])=>`<div class="scenario-row"><span>${label}</span><strong>${Number.isFinite(value)?money(value):'—'}</strong></div>`).join('');const scenarioInputs:Array<[string,number]>=[['Lower case',.9],['Current case',1],['Higher case',1.1]],scenarios=scenarioInputs.map(([label,factor])=>{const next=[...values];next[0]*=factor;return[label,factor,calculate(tool.op,next).primary] as const});root.querySelector<HTMLElement>('[data-scenarios]')!.innerHTML=scenarios.map(([label,factor,value])=>`<div class="scenario-row ${factor===1?'current':''}"><span>${label}<small>${factor===1?'Your inputs':`${factor<1?'−':'+'}10% ${tool.inputs[0].label}`}</small></span><strong>${money(value)}</strong></div>`).join('');const card=root.querySelector<HTMLElement>('[data-amortization-card]')!;if(model.schedule&&model.comparison){card.hidden=false;const c=model.comparison,items:[string,string,string][]=[['Baseline payoff',duration(c.baselineMonths),'Without extra'],['Modeled payoff',duration(c.actualMonths),'With extra'],['Time saved',duration(c.monthsSaved),'Earlier payoff'],['Interest saved',money(c.interestSaved),'Modeled difference']];root.querySelector<HTMLElement>('[data-comparison]')!.innerHTML=items.map(item=>`<article class="metric-card"><span>${item[0]}</span><strong>${item[1]}</strong><small>${item[2]}</small></article>`).join('');root.querySelector<HTMLElement>('[data-amortization]')!.innerHTML=model.schedule.map(row=>`<tr><td>${row.year}</td><td>${money(row.principal)}</td><td>${money(row.interest)}</td><td>${money(row.balance)}</td></tr>`).join('')}else card.hidden=true;root.querySelector<HTMLElement>('[data-stamp]')!.textContent=`Updated ${new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}`};const params=new URLSearchParams(location.search);inputs.forEach((input,index)=>{const saved=params.get(`v${index}`);if(saved!==null)input.value=saved});currency.addEventListener('change',()=>{code=currency.value;localStorage.setItem('calcwise:currency',code);render()});inputs.forEach(input=>input.addEventListener('input',render));root.querySelector('[data-reset]')?.addEventListener('click',()=>{inputs.forEach((input,index)=>input.value=defaults[index]);history.replaceState({},'',location.pathname);render();show('Calculator reset')});root.querySelector('[data-share]')?.addEventListener('click',async()=>{const url=shareUrl();try{if(navigator.share)await navigator.share({title:tool.title,text:`${tool.title}: ${output.textContent}`,url});else{await navigator.clipboard.writeText(url);show('Shareable scenario copied')}}catch{}});root.querySelector('[data-copy]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(`${tool.title}: ${output.textContent}\n${shareUrl()}`);show('Result and link copied')});root.querySelector('[data-print]')?.addEventListener('click',()=>print());render()});
</script>
