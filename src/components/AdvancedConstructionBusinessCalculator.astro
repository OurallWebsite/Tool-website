---
import type { Tool } from '../catalog';import type { Lang } from '../site';import '../styles/tool-detail.css';import '../styles/calculator-preferences.css';
const { tool, lang }: { tool: Tool; lang: Lang } = Astro.props;const construction=tool.op==='squareFootageAdvanced'||tool.op==='concreteAdvanced';
const currencies=[['USD','$'],['EUR','€'],['GBP','£'],['INR','₹'],['AED','د.إ'],['AUD','A$'],['CAD','C$'],['JPY','¥'],['CNY','¥'],['BRL','R$'],['MXN','MX$'],['SGD','S$'],['CHF','CHF'],['ZAR','R'],['NGN','₦'],['PKR','₨']];
---
<section class="tool-workspace" data-construction-business data-tool={JSON.stringify(tool)} data-lang={lang}><div class="workspace-toolbar"><div class="live-state"><span class="live-dot"></span><strong>{construction?'Project quantity planner':'Business scenario model'}</strong><small>Updates as you type</small></div><div class="tool-actions" role="group" aria-label="Calculator actions"><button type="button" class="action-btn" aria-label="Reset calculator" data-reset>↺ <span>Reset</span></button><button type="button" class="action-btn" aria-label="Share calculator" data-share>↗ <span>Share</span></button><button type="button" class="action-btn" aria-label="Copy result" data-copy>⧉ <span>Copy</span></button><button type="button" class="action-btn" aria-label="Print calculator" data-print>▣ <span>Print / PDF</span></button></div></div>
<div class="preference-bar"><div class="preference-group">{construction&&<label><span>Measurement system</span><select data-units><option value="imperial">Imperial — ft, in, yd³</option><option value="metric">Metric — m, cm, m³</option></select></label>}<label><span>Display currency</span><select data-currency>{currencies.map(([code,symbol])=><option value={code}>{symbol} {code}</option>)}</select></label></div><p>{construction?'Verify field measurements and supplier package/yield information before purchasing.':'Scenarios are planning estimates and depend on complete, accurate costs.'}</p></div>
<div class="calculator-stage"><div class="input-panel"><div class="panel-heading"><span class="step-number">01</span><div><strong>{construction?'Project inputs':'Business inputs'}</strong><small>Adjust any assumption to recalculate</small></div></div><div class="input-grid">{tool.inputs.map((input,index)=><label class="advanced-field"><span data-label={index}>{input.label}</span><div class="input-wrap"><input type="number" value={input.value} step={input.step||'any'} min={input.min} max={input.max} required inputmode="decimal" data-input-index={index}/><small>{input.help}</small></div><em data-error={index}></em></label>)}</div><p class="browser-note">🔒 Values remain in your browser.</p></div><aside class="result-panel"><span class="result-kicker">Primary result</span><output aria-live="polite">—</output><strong class="result-unit" data-unit></strong><span class="result-status good" data-status>Model ready</span><p data-interpretation></p></aside></div>
<section class="analytics-zone"><div class="section-heading-row"><div><span class="eyebrow">Detailed report</span><h2>{construction?'Quantity, packages and cost':'Profitability and break-even analysis'}</h2></div><span class="calculation-stamp" data-stamp>Calculated now</span></div><div class="metric-grid">{[0,1,2,3].map(index=><article class="metric-card"><span data-metric-label={index}>Metric</span><strong data-metric-value={index}>—</strong><small data-metric-note={index}></small></article>)}</div><div class="visual-grid"><article class="analytics-card wide-card"><div class="analytics-card-head"><div><span class="eyebrow">Breakdown</span><h3>Calculation components</h3></div></div><div class="scenario-list" data-breakdown></div></article><article class="analytics-card score-card"><div class="analytics-card-head"><div><span class="eyebrow">Important</span><h3>Planning note</h3></div></div><p data-note></p></article></div><article class="analytics-card scenario-card"><div class="analytics-card-head"><div><span class="eyebrow">Sensitivity</span><h3>{construction?'Waste allowance scenarios':'Best, base and lower cases'}</h3></div></div><div class="scenario-list" data-scenarios></div></article></section><div class="copy-toast" role="status" aria-live="polite" data-toast hidden>Copied</div></section>
<style>.preference-group{display:flex;gap:18px;flex-wrap:wrap}.preference-group label{display:flex;align-items:center;gap:8px}@media(max-width:600px){.preference-group{width:100%;flex-direction:column}.preference-group label{align-items:flex-start;flex-direction:column}.preference-group select{width:100%}}</style>
<script>
type Kind='money'|'percent'|'number'|'area'|'volume'|'units';type Metric=[string,number|string,Kind,string];type Model={primary:number;primaryKind:Kind;unit:string;status:string;interpretation:string;note:string;metrics:Metric[];breakdown:Metric[]};
const currencyLocales:Record<string,string>={USD:'en-US',EUR:'de-DE',GBP:'en-GB',INR:'en-IN',AED:'ar-AE',AUD:'en-AU',CAD:'en-CA',JPY:'ja-JP',CNY:'zh-CN',BRL:'pt-BR',MXN:'es-MX',SGD:'en-SG',CHF:'de-CH',ZAR:'en-ZA',NGN:'en-NG',PKR:'en-PK'};const round=(x:number,d=2)=>Number(x.toFixed(d));
function calculate(op:string,v:number[],units:string):Model{if(op==='squareFootageAdvanced'){const[length,width,waste,coverage,cost]=v,area=length*width,required=area*(1+waste/100),packages=Math.ceil(required/coverage),total=packages*cost;return{primary:total,primaryKind:'money',unit:'estimated material cost',status:'Package estimate',interpretation:`Order approximately ${packages} packages to cover the waste-adjusted area.`,note:'Package coverage and installation patterns vary. Round up and confirm supplier specifications.',metrics:[['Measured area',area,'area','Length × width'],['Required with waste',required,'area',`${waste}% allowance`],['Packages',packages,'units','Rounded up'],['Estimated cost',total,'money','Packages × price']],breakdown:[['Base area',area,'area','Measured'],['Waste area',required-area,'area','Additional'],['Coverage/package',coverage,'area','Supplier input'],['Package price',cost,'money','Supplier input']]}}
if(op==='concreteAdvanced'){const[length,width,depth,waste,price]=v,base=units==='metric'?length*width*depth/100:length*width*(depth/12)/27,required=base*(1+waste/100),total=required*price;return{primary:required,primaryKind:'volume',unit:'order volume',status:'Volume estimate',interpretation:`The waste-adjusted order is ${round(required,3)} ${units==='metric'?'m³':'yd³'}.`,note:'Subgrade variation, forms, spillage and supplier minimums can change the actual order.',metrics:[['Base volume',base,'volume','Dimensions only'],['Order volume',required,'volume',`${waste}% allowance`],['Estimated cost',total,'money','Volume × price'],['Waste volume',required-base,'volume','Additional']],breakdown:[['Length',length,'number',units==='metric'?'meters':'feet'],['Width',width,'number',units==='metric'?'meters':'feet'],['Depth',depth,'number',units==='metric'?'centimeters':'inches'],['Price/unit',price,'money',units==='metric'?'per m³':'per yd³']]}}
if(op==='profitMarginAdvanced'){const[revenue,cogs,expenses]=v,gross=revenue-cogs,net=gross-expenses,grossMargin=gross/revenue*100,netMargin=net/revenue*100,markup=cogs?gross/cogs*100:NaN;return{primary:netMargin,primaryKind:'percent',unit:'net margin',status:net>=0?'Profitable scenario':'Loss scenario',interpretation:`Net profit is ${round(net)} after direct and operating costs.`,note:'Taxes, financing costs, owner compensation and non-operating items are excluded unless entered as operating expenses.',metrics:[['Gross profit',gross,'money','Revenue − COGS'],['Gross margin',grossMargin,'percent','Gross profit ÷ revenue'],['Net profit',net,'money','After operating expenses'],['Net margin',netMargin,'percent','Net profit ÷ revenue']],breakdown:[['Revenue',revenue,'money','Sales'],['COGS',cogs,'money','Direct cost'],['Operating expenses',expenses,'money','Other included cost'],['Markup',markup,'percent','Gross profit ÷ COGS']]}}
if(op==='breakEvenAdvanced'){const[fixed,price,variable,target]=v,contribution=price-variable,viable=price>0&&contribution>0,unitsBreak=viable?Math.ceil(fixed/contribution):NaN,targetUnits=viable?Math.ceil((fixed+target)/contribution):NaN,ratio=viable?contribution/price*100:NaN,revenue=viable?unitsBreak*price:NaN,targetRevenue=viable?targetUnits*price:NaN;return{primary:unitsBreak,primaryKind:'units',unit:'break-even units',status:viable?'Positive contribution margin':'Check contribution margin',interpretation:viable?`Sell approximately ${unitsBreak} units to cover fixed and variable costs.`:price<=0?'Selling price must be greater than zero.':'Selling price must exceed variable cost to reach break-even.',note:'Break-even analysis assumes constant price, unit variable cost and fixed costs over the modeled period. It is a planning estimate, not a forecast.',metrics:[['Contribution/unit',contribution,'money','Price − variable cost'],['Contribution ratio',ratio,'percent','Contribution ÷ price'],['Break-even units',unitsBreak,'units','Rounded up'],['Target-profit units',targetUnits,'units','Includes target profit']],breakdown:[['Fixed costs',fixed,'money','Period total'],['Break-even revenue',revenue,'money','Break-even units × price'],['Target profit',target,'money','Goal above break-even'],['Target revenue',targetRevenue,'money','Target units × price']]}}
throw new Error(`Unsupported construction/business operation: ${op}`);}
document.querySelectorAll<HTMLElement>('[data-construction-business]').forEach(root=>{const tool=JSON.parse(root.dataset.tool||'{}'),inputs=[...root.querySelectorAll<HTMLInputElement>('input[data-input-index]')],defaults=inputs.map(i=>i.defaultValue),unitSelect=root.querySelector<HTMLSelectElement>('[data-units]'),currency=root.querySelector<HTMLSelectElement>('[data-currency]')!,output=root.querySelector<HTMLOutputElement>('output')!,toast=root.querySelector<HTMLElement>('[data-toast]')!;let units=unitSelect?.value||'imperial',code=new URLSearchParams(location.search).get('currency')||localStorage.getItem('calcwise:currency')||'USD';if([...currency.options].some(o=>o.value===code))currency.value=code;else code='USD';const money=(x:number)=>Number.isFinite(x)?new Intl.NumberFormat(currencyLocales[code]||'en-US',{style:'currency',currency:code,maximumFractionDigits:2}).format(x):'—';const num=(x:number)=>Number.isFinite(x)?new Intl.NumberFormat(undefined,{maximumFractionDigits:3}).format(x):'—';const format=(value:number|string,kind:Kind)=>typeof value==='string'?value:kind==='money'?money(value):kind==='percent'?`${num(value)}%`:kind==='area'?`${num(value)} ${units==='metric'?'m²':'ft²'}`:kind==='volume'?`${num(value)} ${units==='metric'?'m³':'yd³'}`:kind==='units'?`${Number.isFinite(value)?Math.ceil(value):'—'} units`:num(value);const show=(t:string)=>{toast.textContent=t;toast.hidden=false;setTimeout(()=>toast.hidden=true,2000)};const values=()=>inputs.map(i=>Number(i.value));const modelFor=(next=values())=>calculate(tool.op,next,units);const validate=()=>{let valid=true;inputs.forEach((input,index)=>{const message=input.value===''?'Enter a value.':!Number.isFinite(Number(input.value))?'Enter a valid number.':input.validity.rangeUnderflow?`Minimum is ${input.min}.`:input.validity.rangeOverflow?`Maximum is ${input.max}.`:input.validity.stepMismatch?`Use increments of ${input.step}.`:'';input.setAttribute('aria-invalid',message?'true':'false');root.querySelector<HTMLElement>(`[data-error="${index}"]`)!.textContent=message;if(message)valid=false});return valid};const updateLabels=()=>{if(!unitSelect)return;if(tool.op==='squareFootageAdvanced'){root.querySelector<HTMLElement>('[data-label="0"]')!.textContent=`Length (${units==='metric'?'m':'ft'})`;root.querySelector<HTMLElement>('[data-label="1"]')!.textContent=`Width (${units==='metric'?'m':'ft'})`;root.querySelector<HTMLElement>('[data-label="3"]')!.textContent=`Coverage per package (${units==='metric'?'m²':'ft²'})`}else{root.querySelector<HTMLElement>('[data-label="0"]')!.textContent=`Length (${units==='metric'?'m':'ft'})`;root.querySelector<HTMLElement>('[data-label="1"]')!.textContent=`Width (${units==='metric'?'m':'ft'})`;root.querySelector<HTMLElement>('[data-label="2"]')!.textContent=`Depth (${units==='metric'?'cm':'in'})`;root.querySelector<HTMLElement>('[data-label="4"]')!.textContent=`Price per ${units==='metric'?'m³':'yd³'}`}};const shareUrl=()=>{const url=new URL(location.href);inputs.forEach((input,index)=>url.searchParams.set(`v${index}`,input.value));if(unitSelect)url.searchParams.set('units',units);url.searchParams.set('currency',code);return url.toString()};const render=()=>{if(!validate()){output.textContent='—';return}const model=modelFor();output.textContent=format(model.primary,model.primaryKind);root.querySelector<HTMLElement>('[data-unit]')!.textContent=model.unit;const status=root.querySelector<HTMLElement>('[data-status]')!;status.textContent=model.status;status.classList.toggle('good',!model.status.startsWith('Check'));status.classList.toggle('warn',model.status.startsWith('Check'));root.querySelector<HTMLElement>('[data-interpretation]')!.textContent=model.interpretation;root.querySelector<HTMLElement>('[data-note]')!.textContent=model.note;model.metrics.forEach((row,index)=>{root.querySelector<HTMLElement>(`[data-metric-label="${index}"]`)!.textContent=row[0];root.querySelector<HTMLElement>(`[data-metric-value="${index}"]`)!.textContent=format(row[1],row[2]);root.querySelector<HTMLElement>(`[data-metric-note="${index}"]`)!.textContent=row[3]});root.querySelector<HTMLElement>('[data-breakdown]')!.innerHTML=model.breakdown.map(row=>`<div class="scenario-row"><span>${row[0]}<small>${row[3]}</small></span><strong>${format(row[1],row[2])}</strong></div>`).join('');const base=values(),scenarios:Array<[string,number]>=[['Lower case',.9],['Base case',1],['Higher case',1.1]];root.querySelector<HTMLElement>('[data-scenarios]')!.innerHTML=scenarios.map(([label,factor])=>{const next=[...base];if(tool.op==='squareFootageAdvanced'||tool.op==='concreteAdvanced')next[3]=base[3]*factor;else if(tool.op==='profitMarginAdvanced')next[0]=base[0]*factor;else next[1]=base[1]*factor;const m=modelFor(next);return`<div class="scenario-row ${factor===1?'current':''}"><span>${label}<small>${factor===1?'Entered assumptions':`${factor<1?'−':'+'}10% scenario`}</small></span><strong>${format(m.primary,m.primaryKind)}</strong></div>`}).join('');root.querySelector<HTMLElement>('[data-stamp]')!.textContent=`Updated ${new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}`};const params=new URLSearchParams(location.search);inputs.forEach((input,index)=>{const saved=params.get(`v${index}`);if(saved!==null)input.value=saved});if(unitSelect&&params.get('units')){units=params.get('units')!;unitSelect.value=units}updateLabels();unitSelect?.addEventListener('change',()=>{const to=unitSelect.value;if(to===units)return;const f=to==='metric'?.3048:1/.3048,areaF=to==='metric'?.09290304:1/.09290304;inputs[0].value=String(round(Number(inputs[0].value)*f,3));inputs[1].value=String(round(Number(inputs[1].value)*f,3));if(tool.op==='squareFootageAdvanced')inputs[3].value=String(round(Number(inputs[3].value)*areaF,3));else{inputs[2].value=String(round(Number(inputs[2].value)*(to==='metric'?2.54:1/2.54),3));inputs[4].value=String(round(Number(inputs[4].value)*(to==='metric'?1/.764554857984:.764554857984),2))}units=to;localStorage.setItem('calcwise:construction-units',units);updateLabels();render()});currency.addEventListener('change',()=>{code=currency.value;localStorage.setItem('calcwise:currency',code);render()});inputs.forEach(i=>i.addEventListener('input',render));root.querySelector('[data-reset]')?.addEventListener('click',()=>{inputs.forEach((input,index)=>input.value=defaults[index]);units='imperial';if(unitSelect)unitSelect.value='imperial';history.replaceState({},'',location.pathname);updateLabels();render();show('Calculator reset')});root.querySelector('[data-share]')?.addEventListener('click',async()=>{const url=shareUrl();try{if(navigator.share)await navigator.share({title:tool.title,text:`${tool.title}: ${output.textContent}`,url});else{await navigator.clipboard.writeText(url);show('Shareable scenario copied')}}catch{}});root.querySelector('[data-copy]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(`${tool.title}: ${output.textContent}\n${shareUrl()}`);show('Result and link copied')});root.querySelector('[data-print]')?.addEventListener('click',()=>print());render()});
</script>
