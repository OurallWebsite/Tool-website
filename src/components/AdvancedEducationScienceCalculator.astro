---
import type { Tool } from '../catalog';import type { Lang } from '../site';import '../styles/tool-detail.css';import '../styles/calculator-preferences.css';const {tool,lang}:{tool:Tool;lang:Lang}=Astro.props;const ohmsLaw=tool.slug==='ohms-law-calculator';const forceLaw=tool.slug==='force-calculator';const kineticLaw=tool.slug==='kinetic-energy-calculator';const potentialLaw=tool.slug==='potential-energy-calculator';
---
<section class="tool-workspace" data-edu-science data-tool={JSON.stringify(tool)} data-lang={lang}><div class="workspace-toolbar"><div class="live-state"><span class="live-dot"></span><strong>Advanced {tool.category} model</strong><small>Updates as you type</small></div><div class="tool-actions" role="group" aria-label="Calculator actions"><button class="action-btn" type="button" aria-label="Reset calculator" data-reset>↺ Reset</button><button class="action-btn" type="button" aria-label="Share calculator" data-share>↗ Share</button><button class="action-btn" type="button" aria-label="Copy result" data-copy>⧉ Copy</button><button class="action-btn" type="button" aria-label="Print / PDF" data-print>▣ Print / PDF</button></div></div><div class="calculator-stage"><div class="input-panel"><div class="panel-heading"><span class="step-number">01</span><div><strong>Inputs</strong><small>Use consistent units and verified values</small></div></div>{tool.slug==='gpa-calculator'&&<div class="gpa-scale"><label for={`gpa-scale-${tool.slug}`}><span>Grade scale</span><select id={`gpa-scale-${tool.slug}`} data-gpa-scale><option value="4">4.0 scale</option><option value="5">5.0 scale</option><option value="10">10.0 scale</option></select></label><p>Choose the scale used by your institution before interpreting the result.</p></div>}{ohmsLaw&&<div class="ohms-mode"><label for={`ohms-mode-${tool.slug}`}><span>Known values</span><select id={`ohms-mode-${tool.slug}`} data-ohms-mode><option value="current-resistance">Current + resistance → voltage</option><option value="voltage-current">Voltage + current → resistance</option><option value="voltage-resistance">Voltage + resistance → current</option><option value="voltage-power">Voltage + power → current</option><option value="current-power">Current + power → voltage</option><option value="resistance-power">Resistance + power → current</option></select></label><p>Enter any two compatible values. The calculator derives the missing electrical quantity and power.</p></div>}{forceLaw&&<div class="force-mode"><label for={`force-mode-${tool.slug}`}><span>Solve for</span><select id={`force-mode-${tool.slug}`} data-force-mode><option value="force">Force (F) from mass and acceleration</option><option value="mass">Mass (m) from force and acceleration</option><option value="acceleration">Acceleration (a) from force and mass</option></select></label><p>Use consistent SI units: kg, m/s², and N.</p></div>}{kineticLaw&&<div class="kinetic-mode"><label for={`kinetic-mode-${tool.slug}`}><span>Solve for</span><select id={`kinetic-mode-${tool.slug}`} data-kinetic-mode><option value="energy">Kinetic energy (KE) from mass and velocity</option><option value="mass">Mass (m) from energy and velocity</option><option value="velocity">Velocity (v) from energy and mass</option></select></label><p>Use consistent SI units: kg, m/s, and joules.</p></div>}{potentialLaw&&<div class="potential-mode"><label for={`potential-mode-${tool.slug}`}><span>Solve for</span><select id={`potential-mode-${tool.slug}`} data-potential-mode><option value="energy">Potential energy (PE) from mass, gravity, and height</option><option value="mass">Mass (m) from energy, gravity, and height</option><option value="gravity">Gravity (g) from energy, mass, and height</option><option value="height">Height (h) from energy, mass, and gravity</option></select></label><p>Use consistent SI units: kg, m/s², m, and joules.</p></div>}<div class="input-grid">{tool.inputs.map((input,index)=><label class="advanced-field"><span>{input.label}</span><div class="input-wrap"><input type="number" value={input.value} step={input.step||'any'} min={input.min} max={input.max} data-input-index={index} required/><small>{input.help||'Value used in the displayed formula.'}</small></div><em data-error={index}></em></label>)}</div></div><aside class="result-panel"><span class="result-kicker">Primary result</span><output aria-live="polite">—</output><strong class="result-unit" data-unit></strong><span class="result-status good" data-status>Model ready</span><p data-interpretation></p></aside></div><section class="analytics-zone"><div class="section-heading-row"><div><span class="eyebrow">Detailed report</span><h2>Calculated values</h2></div><span class="calculation-stamp" data-stamp></span></div><div class="metric-grid">{[0,1,2,3].map(i=><article class="metric-card"><span data-label={i}></span><strong data-value={i}>—</strong><small data-note={i}></small></article>)}</div><article class="analytics-card scenario-card"><div class="analytics-card-head"><div><span class="eyebrow">Sensitivity</span><h3>Input scenarios</h3></div></div><div class="scenario-list" data-scenarios></div></article><article class="analytics-card"><h3>Method and limitation</h3><p data-method></p></article></section><div class="copy-toast" data-toast hidden></div></section>
<script>
type Metric=[string,string,string];type Model={primary:number;unit:string;status:string;interpretation:string;method:string;metrics:Metric[]};const n=(x:number,d=3)=>Number.isFinite(x)?new Intl.NumberFormat(undefined,{maximumFractionDigits:d}).format(x):'—';
function calc(slug:string,v:number[],mode='current-resistance',scale=4):Model{let p=0,u='',status='Calculated',interpretation='',method='',m:Metric[]=[];if(slug==='ohms-law-calculator'){const[a,b]=v;let power=NaN,resultLabel='',firstLabel='',secondLabel='';if(mode==='voltage-current'){p=a/b;power=a*b;u='Ω';resultLabel='Resistance';firstLabel='Voltage (V)';secondLabel='Current (A)';method='Ohm’s law rearranged to R = V ÷ I. Power is calculated as P = V × I.'}else if(mode==='voltage-resistance'){p=a/b;power=a*a/b;u='A';resultLabel='Current';firstLabel='Voltage (V)';secondLabel='Resistance (Ω)';method='Ohm’s law rearranged to I = V ÷ R. Power is calculated as P = V² ÷ R.'}else if(mode==='voltage-power'){p=b/a;power=b;u='A';resultLabel='Current';firstLabel='Voltage (V)';secondLabel='Power (W)';method='Power law rearranged to I = P ÷ V. Resistance is also derived as R = V² ÷ P.'}else if(mode==='current-power'){p=b/a;power=b;u='V';resultLabel='Voltage';firstLabel='Current (A)';secondLabel='Power (W)';method='Power law rearranged to V = P ÷ I. Resistance is also derived as R = P ÷ I².'}else if(mode==='resistance-power'){p=Math.sqrt(b/a);power=b;u='A';resultLabel='Current';firstLabel='Resistance (Ω)';secondLabel='Power (W)';method='Power law rearranged to I = √(P ÷ R). Voltage is also derived as V = √(P × R).'}else{p=a*b;power=a*b*a;u='V';resultLabel='Voltage';firstLabel='Current (A)';secondLabel='Resistance (Ω)';method='Ohm’s law V = I × R. Power is calculated as P = I² × R.'}const valid=Number.isFinite(p)&&Number.isFinite(power)&&a>=0&&b>=0;status=valid?'Calculated':'Check inputs';interpretation=valid?`${resultLabel} is ${n(p)} ${u}.`:'Use positive values and avoid zero when it is a divisor.';m=[[resultLabel,n(p),`Derived from ${firstLabel} and ${secondLabel}`],['Power',`${n(power)} W`,'Electrical power'],[firstLabel,n(a),'Entered'],[secondLabel,n(b),'Entered']];return{primary:p,unit:u,status,interpretation,method,metrics:m}}
if(slug==='gpa-calculator'){const[points,credits]=v;p=credits?points/credits:NaN;u='GPA';status=Number.isFinite(p)&&p>=0&&p<=scale?`Within ${n(scale,1)} scale`:'Check scale';interpretation=`Average grade points per credit: ${n(p)} on the selected ${n(scale,1)} scale.`;method='Divide total quality/grade points by attempted credits. Institutional repeat, transfer and rounding rules can differ.';m=[['GPA',n(p),'Points ÷ credits'],['Scale',n(scale,1),'Selected scale'],['Credits',n(credits),'Attempted credits'],['Quality points',n(points),'Entered total']]}
else if(slug==='grade-percentage-calculator'){const[e,t,curve=0]=v,valid=e>=0&&t>0&&e<=t,raw=valid?e/t*100:NaN,adjusted=valid?(e+curve)/t*100:NaN;p=adjusted;u='%';status=!valid?'Check points':adjusted>100?'Above 100% with bonus':'Calculated';interpretation=valid?`Your adjusted score is ${n(adjusted)}% from ${n(e)} earned points, ${n(t)} possible points, and ${n(curve)} curve points.`:'Earned points cannot exceed possible points, and possible points must be positive.';method='Raw percentage = points earned ÷ points possible × 100. Adjusted percentage adds an entered curve or bonus before dividing; letter-grade cutoffs are institution-specific.';m=[['Adjusted grade',`${n(adjusted)}%`,'(Earned + curve) ÷ possible'],['Raw grade',`${n(raw)}%`,'Earned ÷ possible'],['Points missed',n(t-e),'Possible − earned'],['Curve/bonus',n(curve),'Added points']] }
else if(slug==='weighted-grade-calculator'){const[s,w,current]=v,valid=s>=0&&s<=100&&w>=0&&w<=100&&current>=0&&current<=100,contribution=valid?s*w/100:NaN,currentContribution=valid?current*(1-w/100):NaN,projected=valid?currentContribution+contribution:NaN;p=projected;u='% projected grade';status=valid?`Projected from ${n(w,1)}% item weight`:'Check grade inputs';interpretation=valid?`A ${n(s)}% score worth ${n(w)}% projects the course grade at ${n(projected)}%.`:'Scores and weight must be between 0% and 100%.';method='Projected course grade = current grade × (1 − item weight) + item score × item weight. For multiple categories, weighted grade = sum(score × weight) ÷ sum(weights).';m=[['Projected course grade',`${n(projected)}%`,'Current work + item'],['Item contribution',`${n(contribution)} pts`,'Score × weight'],['Current-work contribution',`${n(currentContribution)} pts`,'Current grade × remaining weight'],['Remaining weight',`${n(100-w)}%`,'1 − item weight']] }
else if(slug==='final-exam-calculator'){const[current,desired,weight]=v,valid=current>=0&&current<=100&&desired>=0&&desired<=100&&weight>0&&weight<=100,remaining=1-weight/100,rawRequired=valid?(desired-current*remaining)/(weight/100):NaN,required=Number.isFinite(rawRequired)?Math.max(0,rawRequired):NaN;p=required;u='% needed';status=!valid?'Check grade inputs':rawRequired>100?'Target exceeds 100%':rawRequired<=0?'Target already secured':'Target feasible';interpretation=!valid?'Current grade, desired grade, and final weight must be valid percentages.':rawRequired>100?`You would need ${n(rawRequired)}% on the final, which exceeds the 100% maximum.`:rawRequired<=0?'Your current grade already meets the desired course grade.':`You need at least ${n(rawRequired)}% on the final to reach the target.`;method='Required final = (desired course grade − current grade × (1 − final weight)) ÷ final weight. This assumes a simple weighted average and does not model curves, extra credit, dropped scores, or instructor policies.';m=[['Required final',`${n(required)}%`,'Target equation'],['Current contribution',`${n(current*remaining)} pts`,'Before final'],['Final weight',`${n(weight)}%`,'Entered'],['Remaining weight',`${n(100-weight)}%`,'Current grade share']] }
else if(slug==='attendance-calculator'){const[a,t,threshold,remainingClasses]=v,valid=a>=0&&t>0&&a<=t&&threshold>=0&&threshold<=100&&remainingClasses>=0,current=valid?a/t*100:NaN,futureTotal=valid?t+remainingClasses:NaN,targetAttended=valid?Math.ceil(futureTotal*threshold/100):NaN,neededFuture=valid&&current<threshold?Math.max(0,targetAttended-a):0,canMiss=valid?Math.max(0,a+remainingClasses-targetAttended):NaN,projectedIfAttendAll=valid?(a+remainingClasses)/futureTotal*100:NaN;p=current;u='% attendance';status=!valid?'Check attendance inputs':current>=threshold?'Meets threshold':a+remainingClasses>=targetAttended?'Below threshold — recoverable':'Below threshold — not recoverable';interpretation=!valid?'Attended classes cannot exceed total classes, and totals, threshold, and remaining classes must be valid.':current>=threshold?`Current attendance is ${n(current)}%; you can miss up to ${n(canMiss,0)} of the remaining ${n(remainingClasses,0)} classes and stay at or above ${n(threshold)}%.`:a+remainingClasses>=targetAttended?`Attend at least ${n(neededFuture,0)} of the remaining ${n(remainingClasses,0)} classes to reach ${n(threshold)}% attendance.`:`Even attending every remaining class would project only ${n(projectedIfAttendAll)}%, below the ${n(threshold)}% threshold.`;method='Attendance % = attended ÷ total × 100. For planning, required attendance = ceiling((total held + remaining classes) × threshold); classes to attend = required attendance − attended; classes that can be missed = remaining − classes to attend. Policies, excused absences, rounding, and subject-specific rules vary.';m=[['Current attendance',valid?`${n(current)}%`:'—','Attended ÷ total'],['Classes missed',valid?n(t-a):'—','Total − attended'],['Need to attend',valid?n(neededFuture,0):'—','To reach threshold'],['Can miss',valid?n(canMiss,0):'—','Of remaining classes']]}
else if(slug==='reading-time-calculator'){const[w,s,a]=v,valid=w>=0&&s>0&&a>0,silent=valid?w/s:NaN,aloud=valid?w/a:NaN;p=silent;u='minutes silent';status=!valid?'Check reading inputs':silent<1?'Under 1 minute':'Estimated reading time';interpretation=!valid?'Word count cannot be negative, and both reading speeds must be greater than zero.':`${n(w,0)} words take about ${n(silent)} minutes to read silently at ${n(s,0)} WPM, or ${n(aloud)} minutes aloud at ${n(a,0)} WPM.`;method='Reading time = word count ÷ words per minute. The 200 and 300 WPM comparison cases are directional benchmarks; language, subject difficulty, familiarity, accessibility needs, and comprehension change real reading time.';m=[['Silent reading',`${n(silent)} min`,'Words ÷ silent WPM'],['Read aloud',`${n(aloud)} min`,'Words ÷ aloud WPM'],['Slow silent pace',`${n(w/200)} min`,'Benchmark at 200 WPM'],['Fast silent pace',`${n(w/300)} min`,'Benchmark at 300 WPM']]}
else if(slug==='words-to-pages-calculator'){const[w,pp]=v,valid=w>=0&&pp>0,pages=valid?w/pp:NaN,single=valid?w/500:NaN,double=valid?w/250:NaN;p=pages;u='pages';status=!valid?'Check page inputs':'Estimated pages';interpretation=!valid?'Word count cannot be negative, and words per page must be greater than zero.':`${n(w,0)} words at ${n(pp,0)} words per page is about ${n(pages)} pages. Actual pagination changes with font, spacing, margins, page size, headings, tables, and images.`;method='Pages = word count ÷ words per page. As directional benchmarks, a conventional 12-point document is often around 500 words per single-spaced page or 250 words per double-spaced page; the selected density should match the actual document format.';m=[['Estimated pages',n(pages),'Words ÷ selected density'],['Rounded pages',n(Math.ceil(pages),0),'Whole pages'],['Single-spaced benchmark',n(single),'At 500 words/page'],['Double-spaced benchmark',n(double),'At 250 words/page']]}
else if(slug==='study-time-calculator'){const[c,credits,hoursPerCredit,weeks]=v,valid=c>0&&credits>0&&hoursPerCredit>0&&weeks>0,weekly=valid?c*credits*hoursPerCredit:NaN,daily=valid?weekly/7:NaN,perCourse=valid?credits*hoursPerCredit:NaN,term=valid?weekly*weeks:NaN;p=weekly;u='hours/week';status=!valid?'Check study inputs':'Estimated study load';interpretation=!valid?'Courses, credits, study hours per credit, and term length must all be greater than zero.':`${n(c,0)} courses at ${n(credits,1)} credits each and ${n(hoursPerCredit,1)} study hours per credit imply about ${n(weekly,1)} hours per week (${n(daily,1)} per day) over a ${n(weeks,0)}-week term.`;method='Weekly study = courses × credits per course × study hours per credit per week. Daily average = weekly study ÷ 7; term total = weekly study × weeks. The result is a planning heuristic: programs, course intensity, labs, assessments, and institutional policies can require more or less time.';m=[['Weekly study',`${n(weekly,1)} hours`,'Courses × credits × hours/credit'],['Daily average',`${n(daily,1)} hours`,'Weekly ÷ 7'],['Per-course weekly',`${n(perCourse,1)} hours`,'Credits × hours/credit'],['Term total',`${n(term,0)} hours`,'Weekly × weeks']]}
else if(slug==='force-calculator'){const[x,y]=v;let label='',valid=false;if(mode==='mass'){p=y?x/y:NaN;u='kg';label='Mass';valid=Number.isFinite(p)&&x>=0&&y>0;interpretation=valid?`Mass is ${n(p)} kilograms.`:'Force must be non-negative and acceleration must be greater than zero.';method='Rearranged Newton’s second law: m = F ÷ a. This solves for inertial mass in a one-dimensional, constant-mass model.';m=[[label,`${n(p)} kg`,'F ÷ a'],['Force',`${n(x)} N`,'Entered'],['Acceleration',`${n(y)} m/s²`,'Entered'],['Formula','m = F ÷ a','Inverse F = ma']]}else if(mode==='acceleration'){p=y?x/y:NaN;u='m/s²';label='Acceleration';valid=Number.isFinite(p)&&x>=0&&y>0;interpretation=valid?`Acceleration is ${n(p)} m/s².`:'Force must be non-negative and mass must be greater than zero.';method='Rearranged Newton’s second law: a = F ÷ m. This gives net acceleration when the entered force is the resultant force.';m=[[label,`${n(p)} m/s²`,'F ÷ m'],['Force',`${n(x)} N`,'Entered'],['Mass',`${n(y)} kg`,'Entered'],['Formula','a = F ÷ m','Inverse F = ma']]}else{p=x*y;u='N';label='Force';valid=Number.isFinite(p)&&x>=0&&y>=0;interpretation=valid?`Net force is ${n(p)} newtons.`:'Mass and acceleration must be non-negative numbers.';method='Newton’s second law: F = m × a. This models net force in a consistent SI unit system; friction, gravity, drag, and other forces must be included in the net inputs when relevant.';m=[[label,`${n(p)} N`,'m × a'],['Kilonewtons',`${n(p/1000)} kN`,'N ÷ 1000'],['Mass',`${n(x)} kg`,'Entered'],['Acceleration',`${n(y)} m/s²`,'Entered']]}status=valid?'Calculated':'Check force inputs'}
else if(slug==='kinetic-energy-calculator'){const[x,y]=v;let label='',valid=false;if(mode==='mass'){p=y?2*x/(y*y):NaN;u='kg';label='Mass';valid=Number.isFinite(p)&&x>=0&&y>0;interpretation=valid?`Mass is ${n(p)} kilograms.`:'Energy must be non-negative and velocity must be greater than zero.';method='Rearranged classical kinetic-energy equation: m = 2KE ÷ v². This assumes speeds far below the speed of light.';m=[[label,`${n(p)} kg`,'2KE ÷ v²'],['Energy',`${n(x)} J`,'Entered'],['Velocity',`${n(y)} m/s`,'Entered'],['Formula','m = 2KE ÷ v²','Inverse KE = ½mv²']]}else if(mode==='velocity'){p=y?Math.sqrt(2*x/y):NaN;u='m/s';label='Velocity';valid=Number.isFinite(p)&&x>=0&&y>0;interpretation=valid?`Velocity is ${n(p)} meters per second.`:'Energy must be non-negative and mass must be greater than zero.';method='Rearranged classical kinetic-energy equation: v = √(2KE ÷ m). This returns speed magnitude, not a direction.';m=[[label,`${n(p)} m/s`,'√(2KE ÷ m)'],['Energy',`${n(x)} J`,'Entered'],['Mass',`${n(y)} kg`,'Entered'],['Formula','v = √(2KE ÷ m)','Inverse KE = ½mv²']]}else{p=.5*x*y*y;u='J';label='Kinetic energy';valid=Number.isFinite(p)&&x>=0&&y>=0;interpretation=valid?`Kinetic energy is ${n(p)} joules.`:'Mass and velocity must be non-negative numbers.';method='Classical kinetic energy: KE = ½mv². This model is appropriate at speeds much lower than the speed of light; relativistic kinetic energy is different.';m=[[label,`${n(p)} J`,'½mv²'],['Kilojoules',`${n(p/1000)} kJ`,'J ÷ 1000'],['Mass',`${n(x)} kg`,'Entered'],['Velocity squared',n(y*y),'m²/s²']]}status=valid?'Calculated':'Check kinetic-energy inputs'}
else if(slug==='potential-energy-calculator'){const[x,y,z]=v;let label='',valid=false;if(mode==='mass'){p=y*z?x/(y*z):NaN;u='kg';label='Mass';valid=Number.isFinite(p)&&x>=0&&y>0&&z>0;interpretation=valid?`Mass is ${n(p)} kilograms.`:'Energy must be non-negative, and gravity and height must be greater than zero.';method='Rearranged gravitational potential-energy equation: m = PE ÷ (g × h). Height is measured from the chosen reference level.';m=[[label,`${n(p)} kg`,'PE ÷ (g × h)'],['Energy',`${n(x)} J`,'Entered'],['Gravity',`${n(y)} m/s²`,'Entered'],['Height',`${n(z)} m`,'Entered']]}else if(mode==='gravity'){p=y*z?x/(y*z):NaN;u='m/s²';label='Gravity';valid=Number.isFinite(p)&&x>=0&&y>0&&z>0;interpretation=valid?`Gravitational acceleration is ${n(p)} m/s².`:'Energy must be non-negative, and mass and height must be greater than zero.';method='Rearranged gravitational potential-energy equation: g = PE ÷ (m × h). Use a local value when modeling another planet or altitude.';m=[[label,`${n(p)} m/s²`,'PE ÷ (m × h)'],['Energy',`${n(x)} J`,'Entered'],['Mass',`${n(y)} kg`,'Entered'],['Height',`${n(z)} m`,'Entered']]}else if(mode==='height'){p=y*z?x/(y*z):NaN;u='m';label='Height';valid=Number.isFinite(p)&&x>=0&&y>0&&z>0;interpretation=valid?`Height is ${n(p)} meters above the reference level.`:'Energy must be non-negative, and mass and gravity must be greater than zero.';method='Rearranged gravitational potential-energy equation: h = PE ÷ (m × g). Potential energy depends on the selected zero-height reference.';m=[[label,`${n(p)} m`,'PE ÷ (m × g)'],['Energy',`${n(x)} J`,'Entered'],['Mass',`${n(y)} kg`,'Entered'],['Gravity',`${n(z)} m/s²`,'Entered']]}else{p=x*y*z;u='J';label='Potential energy';valid=Number.isFinite(p)&&x>=0&&y>=0&&z>=0;interpretation=valid?`Gravitational potential energy is ${n(p)} joules.`:'Mass, gravity, and height must be non-negative numbers.';method='Near-Earth gravitational potential energy: PE = m × g × h. The result depends on the selected reference level; for large altitude changes or orbital problems, use a general-gravity model.';m=[[label,`${n(p)} J`,'m × g × h'],['Kilojoules',`${n(p/1000)} kJ`,'J ÷ 1000'],['Weight',`${n(x*y)} N`,'m × g'],['Height',`${n(z)} m`,'Entered']]}status=valid?'Calculated':'Check potential-energy inputs'}
else if(slug==='ohms-law-calculator'){const[i,r]=v;p=i*r;u='V';const power=p*i;interpretation=`Voltage is ${n(p)} volts.`;method='Ohm’s law for an ideal resistive load; real circuits may be temperature- or frequency-dependent.';m=[['Voltage',`${n(p)} V`,'I × R'],['Power',`${n(power)} W`,'V × I'],['Current',`${n(i)} A`,'Entered'],['Resistance',`${n(r)} Ω`,'Entered']]}
else if(slug==='electric-power-calculator'){const[vlt,i]=v;p=vlt*i;u='W';interpretation=`Electrical power is ${n(p)} watts.`;method='DC or purely resistive calculation; AC power factor is not included.';m=[['Power',`${n(p)} W`,'V × I'],['Kilowatts',`${n(p/1000)} kW`,'W ÷ 1000'],['Energy/hour',`${n(p/1000)} kWh`,'At constant load'],['Resistance',`${n(i?vlt/i:NaN)} Ω`,'V ÷ I']]}
else if(slug==='density-calculator'){const[mass,vol]=v;p=vol?mass/vol:NaN;u='mass/volume';interpretation=`Density is ${n(p)} mass units per volume unit.`;method='Mass and volume units must be mutually consistent.';m=[['Density',n(p),'Mass ÷ volume'],['Specific volume',n(p?1/p:NaN),'Volume ÷ mass'],['Mass',n(mass),'Entered'],['Volume',n(vol),'Entered']]}
else if(slug==='molarity-calculator'){const[moles,l]=v;p=l?moles/l:NaN;u='mol/L';interpretation=`Molarity is ${n(p)} mol/L.`;method='Solution volume, not solvent volume, must be entered in liters.';m=[['Molarity',`${n(p)} mol/L`,'Moles ÷ liters'],['Millimolar',`${n(p*1000)} mM`,'M × 1000'],['Moles',`${n(moles)} mol`,'Entered'],['Volume',`${n(l)} L`,'Entered']]}
else{const[f,w]=v;p=f*w;u='m/s';interpretation=`Wave speed is ${n(p)} m/s.`;method='Frequency and wavelength must describe the same wave under the same conditions.';m=[['Wave speed',`${n(p)} m/s`,'f × λ'],['Frequency',`${n(f)} Hz`,'Entered'],['Wavelength',`${n(w)} m`,'Entered'],['Period',`${n(f?1/f:NaN,6)} s`,'1 ÷ frequency']]};return{primary:p,unit:u,status,interpretation,method,metrics:m}}
