---
import type { Tool } from '../catalog';import type { Lang } from '../site';import '../styles/tool-detail.css';import '../styles/calculator-preferences.css';const {tool,lang}:{tool:Tool;lang:Lang}=Astro.props;
---
<section class="tool-workspace" data-edu-science data-tool={JSON.stringify(tool)} data-lang={lang}><div class="workspace-toolbar"><div class="live-state"><span class="live-dot"></span><strong>Advanced {tool.category} model</strong><small>Updates as you type</small></div><div class="tool-actions" role="group" aria-label="Calculator actions"><button class="action-btn" type="button" aria-label="Reset calculator" data-reset>↺ Reset</button><button class="action-btn" type="button" aria-label="Share calculator" data-share>↗ Share</button><button class="action-btn" type="button" aria-label="Copy result" data-copy>⧉ Copy</button><button class="action-btn" type="button" aria-label="Print calculator" data-print>▣ Print / PDF</button></div></div><div class="calculator-stage"><div class="input-panel"><div class="panel-heading"><span class="step-number">01</span><div><strong>Inputs</strong><small>Use consistent units and verified values</small></div></div><div class="input-grid">{tool.inputs.map((input,index)=><label class="advanced-field"><span>{input.label}</span><div class="input-wrap"><input type="number" value={input.value} step={input.step||'any'} min={input.min} max={input.max} data-input-index={index} required/><small>{input.help||'Value used in the displayed formula.'}</small></div><em data-error={index}></em></label>)}</div></div><aside class="result-panel"><span class="result-kicker">Primary result</span><output aria-live="polite">—</output><strong class="result-unit" data-unit></strong><span class="result-status good" data-status>Model ready</span><p data-interpretation></p></aside></div><section class="analytics-zone"><div class="section-heading-row"><div><span class="eyebrow">Detailed report</span><h2>Calculated values</h2></div><span class="calculation-stamp" data-stamp></span></div><div class="metric-grid">{[0,1,2,3].map(i=><article class="metric-card"><span data-label={i}></span><strong data-value={i}>—</strong><small data-note={i}></small></article>)}</div><article class="analytics-card scenario-card"><div class="analytics-card-head"><div><span class="eyebrow">Sensitivity</span><h3>Input scenarios</h3></div></div><div class="scenario-list" data-scenarios></div></article><article class="analytics-card"><h3>Method and limitation</h3><p data-method></p></article></section><div class="copy-toast" data-toast hidden></div></section>
<script>
type Metric=[string,string,string];type Model={primary:number;unit:string;status:string;interpretation:string;method:string;metrics:Metric[]};const n=(x:number,d=3)=>Number.isFinite(x)?new Intl.NumberFormat(undefined,{maximumFractionDigits:d}).format(x):'—';
function calc(slug:string,v:number[]):Model{let p=0,u='',status='Calculated',interpretation='',method='',m:Metric[]=[];if(slug==='gpa-calculator'){const[points,credits]=v;p=credits?points/credits:NaN;u='GPA';status=p<=4?'Within 4.0 scale':'Check scale';interpretation=`Average grade points per credit: ${n(p)}.`;method='Divide total quality/grade points by attempted credits. Institutional repeat, transfer and rounding rules can differ.';m=[['GPA',n(p),'Points ÷ credits'],['Credits',n(credits),'Attempted credits'],['Quality points',n(points),'Entered total'],['4.0-scale share',`${n(p/4*100)}%`,'Context only']]}
else if(slug==='grade-percentage-calculator'){const[e,t]=v;p=t?e/t*100:NaN;u='%';interpretation=`You earned ${n(p)}% of available points.`;method='Earned points divided by possible points. Letter-grade boundaries are institution-specific.';m=[['Grade',`${n(p)}%`,'Earned ÷ possible'],['Points earned',n(e),'Entered'],['Points missed',n(t-e),'Possible − earned'],['Remaining share',`${n(100-p)}%`,'Not earned']]}
else if(slug==='weighted-grade-calculator'){const[s,w]=v;p=s*w/100;u='percentage points';interpretation=`This item contributes ${n(p)} percentage points to the course grade.`;method='Score multiplied by weight. Combine every category contribution for a full weighted grade.';m=[['Contribution',n(p),'Score × weight'],['Score',`${n(s)}%`,'Entered'],['Weight',`${n(w)}%`,'Course share'],['Lost contribution',n(w-p),'Weight − earned contribution']]}
else if(slug==='final-exam-calculator'){const[current,desired,weight]=v,r=1-weight/100;p=weight?(desired-current*r)/(weight/100):NaN;u='% needed';status=p>100?'Target exceeds 100%':p<=0?'Target already secured':'Target feasible';interpretation=`Required final-exam score: ${n(p)}%.`;method='Assumes current grade represents all non-final work and final weight is accurate. School rounding rules may differ.';m=[['Required final',`${n(p)}%`,'Target equation'],['Current contribution',`${n(current*r)} pts`,'Before final'],['Final weight',`${n(weight)}%`,'Entered'],['Safety target',`${n(p+2)}%`,'Two-point buffer']]}
else if(slug==='attendance-calculator'){const[a,t]=v;p=t?a/t*100:NaN;u='% attendance';interpretation=`Attendance is ${n(p)}%.`;method='Attended classes divided by total classes. Excused absences and policy thresholds are not inferred.';m=[['Attendance',`${n(p)}%`,'Attended ÷ total'],['Attended',n(a),'Classes'],['Missed',n(t-a),'Classes'],['One more class',`${n((a+1)/(t+1)*100)}%`,'If attended']]}
else if(slug==='reading-time-calculator'){const[w,s]=v;p=s?w/s:NaN;u='minutes';interpretation=`Estimated reading time: ${n(p)} minutes.`;method='Word count divided by reading speed; comprehension, language and text difficulty change real time.';m=[['Minutes',n(p),'Words ÷ WPM'],['Hours',n(p/60,2),'Minutes ÷ 60'],['Word count',n(w),'Entered'],['Reading speed',`${n(s)} WPM`,'Entered']]}
else if(slug==='words-to-pages-calculator'){const[w,pp]=v;p=pp?w/pp:NaN;u='pages';interpretation=`Estimated length: ${n(p)} pages.`;method='Words divided by assumed words per page. Font, spacing, margins and headings change pagination.';m=[['Pages',n(p),'Words ÷ density'],['Rounded pages',n(Math.ceil(p),0),'Whole pages'],['Words',n(w),'Entered'],['Words/page',n(pp),'Layout assumption']]}
else if(slug==='study-time-calculator'){const[c]=v;p=c*3;u='hours/week';interpretation=`Plan about ${n(p)} study hours per week.`;method='Uses the common three-hours-per-course planning heuristic, not an institutional requirement.';m=[['Weekly study',n(p),'Courses × 3'],['Daily average',n(p/7,2),'Across 7 days'],['Per course',`3 hours`,'Heuristic'],['Courses',n(c),'Entered']]}
else if(slug==='force-calculator'){const[mass,a]=v;p=mass*a;u='N';interpretation=`Net force is ${n(p)} newtons.`;method='Newton’s second law for constant mass in a consistent SI unit system.';m=[['Force',`${n(p)} N`,'m × a'],['Kilonewtons',`${n(p/1000)} kN`,'N ÷ 1000'],['Mass',`${n(mass)} kg`,'Entered'],['Acceleration',`${n(a)} m/s²`,'Entered']]}
else if(slug==='kinetic-energy-calculator'){const[mass,s]=v;p=.5*mass*s*s;u='J';interpretation=`Kinetic energy is ${n(p)} joules.`;method='Classical non-relativistic kinetic energy.';m=[['Energy',`${n(p)} J`,'½mv²'],['Kilojoules',`${n(p/1000)} kJ`,'J ÷ 1000'],['Mass',`${n(mass)} kg`,'Entered'],['Velocity squared',n(s*s),'m²/s²']]}
else if(slug==='potential-energy-calculator'){const[mass,g,h]=v;p=mass*g*h;u='J';interpretation=`Gravitational potential energy is ${n(p)} joules.`;method='Near-surface approximation with constant entered gravitational acceleration.';m=[['Energy',`${n(p)} J`,'mgh'],['Kilojoules',`${n(p/1000)} kJ`,'J ÷ 1000'],['Weight',`${n(mass*g)} N`,'m × g'],['Height',`${n(h)} m`,'Entered']]}
else if(slug==='ohms-law-calculator'){const[i,r]=v;p=i*r;u='V';const power=p*i;interpretation=`Voltage is ${n(p)} volts.`;method='Ohm’s law for an ideal resistive load; real circuits may be temperature- or frequency-dependent.';m=[['Voltage',`${n(p)} V`,'I × R'],['Power',`${n(power)} W`,'V × I'],['Current',`${n(i)} A`,'Entered'],['Resistance',`${n(r)} Ω`,'Entered']]}
else if(slug==='electric-power-calculator'){const[vlt,i]=v;p=vlt*i;u='W';interpretation=`Electrical power is ${n(p)} watts.`;method='DC or purely resistive calculation; AC power factor is not included.';m=[['Power',`${n(p)} W`,'V × I'],['Kilowatts',`${n(p/1000)} kW`,'W ÷ 1000'],['Energy/hour',`${n(p/1000)} kWh`,'At constant load'],['Resistance',`${n(i?vlt/i:NaN)} Ω`,'V ÷ I']]}
else if(slug==='density-calculator'){const[mass,vol]=v;p=vol?mass/vol:NaN;u='mass/volume';interpretation=`Density is ${n(p)} mass units per volume unit.`;method='Mass and volume units must be mutually consistent.';m=[['Density',n(p),'Mass ÷ volume'],['Specific volume',n(p?1/p:NaN),'Volume ÷ mass'],['Mass',n(mass),'Entered'],['Volume',n(vol),'Entered']]}
else if(slug==='molarity-calculator'){const[moles,l]=v;p=l?moles/l:NaN;u='mol/L';interpretation=`Molarity is ${n(p)} mol/L.`;method='Solution volume, not solvent volume, must be entered in liters.';m=[['Molarity',`${n(p)} mol/L`,'Moles ÷ liters'],['Millimolar',`${n(p*1000)} mM`,'M × 1000'],['Moles',`${n(moles)} mol`,'Entered'],['Volume',`${n(l)} L`,'Entered']]}
else{const[f,w]=v;p=f*w;u='m/s';interpretation=`Wave speed is ${n(p)} m/s.`;method='Frequency and wavelength must describe the same wave under the same conditions.';m=[['Wave speed',`${n(p)} m/s`,'f × λ'],['Frequency',`${n(f)} Hz`,'Entered'],['Wavelength',`${n(w)} m`,'Entered'],['Period',`${n(f?1/f:NaN,6)} s`,'1 ÷ frequency']]};return{primary:p,unit:u,status,interpretation,method,metrics:m}}
document.querySelectorAll<HTMLElement>('[data-edu-science]').forEach(root=>{const tool=JSON.parse(root.dataset.tool||'{}'),inputs=[...root.querySelectorAll<HTMLInputElement>('input')],defaults=inputs.map(i=>i.defaultValue),out=root.querySelector<HTMLOutputElement>('output')!,toast=root.querySelector<HTMLElement>('[data-toast]')!;const render=()=>{if(inputs.some(i=>i.value===''||!Number.isFinite(Number(i.value)))){out.textContent='—';return}const vals=inputs.map(i=>Number(i.value)),model=calc(tool.slug,vals);out.textContent=n(model.primary);root.querySelector<HTMLElement>('[data-unit]')!.textContent=model.unit;root.querySelector<HTMLElement>('[data-status]')!.textContent=model.status;root.querySelector<HTMLElement>('[data-interpretation]')!.textContent=model.interpretation;root.querySelector<HTMLElement>('[data-method]')!.textContent=model.method;model.metrics.forEach((x,i)=>{root.querySelector<HTMLElement>(`[data-label="${i}"]`)!.textContent=x[0];root.querySelector<HTMLElement>(`[data-value="${i}"]`)!.textContent=x[1];root.querySelector<HTMLElement>(`[data-note="${i}"]`)!.textContent=x[2]});root.querySelector<HTMLElement>('[data-scenarios]')!.innerHTML=[.9,1,1.1].map(f=>{const v=[...vals];v[0]*=f;const m=calc(tool.slug,v);return`<div class="scenario-row ${f===1?'current':''}"><span>${f===1?'Current':f<1?'−10% first input':'+10% first input'}</span><strong>${n(m.primary)} ${m.unit}</strong></div>`}).join('');root.querySelector<HTMLElement>('[data-stamp]')!.textContent=`Updated ${new Date().toLocaleTimeString()}`};inputs.forEach(i=>i.addEventListener('input',render));root.querySelector('[data-reset]')?.addEventListener('click',()=>{inputs.forEach((i,x)=>i.value=defaults[x]);render()});root.querySelector('[data-copy]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(`${tool.title}: ${out.textContent}`);toast.textContent='Copied';toast.hidden=false;setTimeout(()=>toast.hidden=true,1800)});root.querySelector('[data-share]')?.addEventListener('click',async()=>{const url=new URL(location.href);inputs.forEach((i,x)=>url.searchParams.set(`v${x}`,i.value));await navigator.clipboard.writeText(url.toString());toast.textContent='Link copied';toast.hidden=false;setTimeout(()=>toast.hidden=true,1800)});root.querySelector('[data-print]')?.addEventListener('click',()=>print());const q=new URLSearchParams(location.search);inputs.forEach((i,x)=>{const v=q.get(`v${x}`);if(v!==null)i.value=v});render()});
</script>
