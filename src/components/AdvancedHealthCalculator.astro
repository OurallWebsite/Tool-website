---
import type { Tool } from '../catalog';
import type { Lang } from '../site';
import '../styles/tool-detail.css';
import '../styles/calculator-preferences.css';
const { tool, lang }: { tool: Tool; lang: Lang } = Astro.props;
const isBmi = tool.op === 'bmiAdvanced';
const isTdee = tool.op === 'tdeeAdvanced';
---
<section class="tool-workspace" data-advanced-health data-tool={JSON.stringify(tool)} data-lang={lang}>
  <div class="workspace-toolbar">
    <div class="live-state"><span class="live-dot"></span><strong>Adult health estimate</strong><small>Updates as you type</small></div>
    <div class="tool-actions" role="group" aria-label="Calculator actions">
      <button type="button" class="action-btn" aria-label="Reset calculator" data-reset>↺ <span>Reset</span></button>
      <button type="button" class="action-btn" aria-label="Share calculator" data-share>↗ <span>Share</span></button>
      <button type="button" class="action-btn" aria-label="Copy result" data-copy>⧉ <span>Copy</span></button>
      <button type="button" class="action-btn" aria-label="Print calculator" data-print>▣ <span>Print / PDF</span></button>
    </div>
  </div>
  <div class="preference-bar">
    <label for={`units-${tool.slug}`}><span>Measurement system</span><select id={`units-${tool.slug}`} data-units><option value="metric">Metric — kg, cm</option><option value="imperial">Imperial — lb, in</option></select></label>
    <p><strong>Educational estimate:</strong> this tool does not diagnose a condition or replace individualized clinical assessment.</p>
  </div>
  <div class="calculator-stage">
    <div class="input-panel">
      <div class="panel-heading"><span class="step-number">01</span><div><strong>Your measurements</strong><small>Use recent, accurate adult measurements</small></div></div>
      <div class="input-grid">
        {tool.inputs.map((input,index)=><label class="advanced-field"><span data-field-label={index}>{input.label}{index===0?' (kg)':index===1?' (cm)':''}</span><div class="input-wrap"><input name={input.key} type="number" value={input.value} step={input.step||'any'} min={input.min} max={input.max} inputmode="decimal" required data-input-index={index} aria-describedby={`health-help-${tool.slug}-${index}`}/><small id={`health-help-${tool.slug}-${index}`}>{input.help}</small></div><em data-error={index}></em></label>)}
        {!isBmi&&<label class="advanced-field"><span>Sex used by equation</span><div class="input-wrap"><select data-sex><option value="female">Female equation (−161)</option><option value="male">Male equation (+5)</option></select><small>Mifflin–St Jeor uses sex-specific constants.</small></div></label>}
        {isTdee&&<label class="advanced-field"><span>Activity level</span><div class="input-wrap"><select data-activity><option value="1.2">Sedentary — little exercise</option><option value="1.375">Light — 1–3 days/week</option><option value="1.55" selected>Moderate — 3–5 days/week</option><option value="1.725">Active — 6–7 days/week</option><option value="1.9">Very active — hard training</option></select><small>Activity factors are broad planning estimates.</small></div></label>}
      </div>
      <p class="browser-note">🔒 Values stay in your browser and are not uploaded.</p>
    </div>
    <aside class="result-panel"><span class="result-kicker">Primary result</span><output aria-live="polite">—</output><strong class="result-unit" data-unit>{isBmi?'kg/m²':'kcal/day'}</strong><span class="result-status" data-status>Estimate ready</span><p data-interpretation>Enter your measurements to see context.</p></aside>
  </div>
  <section class="analytics-zone">
    <div class="section-heading-row"><div><span class="eyebrow">Context report</span><h2>{isBmi?'Adult BMI interpretation':'Energy estimate breakdown'}</h2></div><span class="calculation-stamp" data-stamp>Calculated now</span></div>
    <div class="metric-grid">{[0,1,2,3].map(index=><article class="metric-card"><span data-metric-label={index}>Metric</span><strong data-metric-value={index}>—</strong><small data-metric-note={index}>Live estimate</small></article>)}</div>
    <div class="visual-grid"><article class="analytics-card wide-card"><div class="analytics-card-head"><div><span class="eyebrow">Measurement sensitivity</span><h3>Weight variation scenarios</h3></div><span>−5%, current, +5%</span></div><div class="scenario-list" data-scenarios></div></article><article class="analytics-card score-card"><div class="analytics-card-head"><div><span class="eyebrow">Important</span><h3>Limitations</h3></div></div><p data-note>BMI and energy equations are screening or planning estimates, not direct measurements.</p></article></div>
    <article class="analytics-card scenario-card"><div class="analytics-card-head"><div><span class="eyebrow">References</span><h3>Method and interpretation sources</h3></div></div><p>{isBmi?<><a href="https://www.cdc.gov/bmi/adult-calculator/bmi-categories.html" rel="noopener" target="_blank">CDC adult BMI categories</a> define adult screening ranges. This calculator is intended for adults, not children or teens.</>:<><a href="https://pubmed.ncbi.nlm.nih.gov/2305711/" rel="noopener" target="_blank">Mifflin et al.</a> developed the resting-energy equation from healthy adult measurements. Activity multipliers remain approximate.</>}</p></article>
  </section>
  <div class="copy-toast" role="status" aria-live="polite" data-toast hidden>Copied</div>
</section>
<script>
type Row=[string,string,string];type Model={primary:number;unit:string;status:string;interpretation:string;note:string;metrics:Row[]};
const round=(x:number,d=1)=>Number(x.toFixed(d));
const bmiCategory=(bmi:number)=>bmi<18.5?'Underweight':bmi<25?'Healthy weight':bmi<30?'Overweight':bmi<35?'Obesity class 1':bmi<40?'Obesity class 2':'Obesity class 3';
function calculate(op:string,values:number[],sex:string,activity:number,units:string):Model{let[weight,height,age]=values;if(units==='imperial'){weight*=.45359237;height*=2.54}if(op==='bmiAdvanced'){const meters=height/100,bmi=weight/(meters*meters),low=18.5*meters*meters,high=24.9*meters*meters,category=bmiCategory(bmi),displayLow=units==='imperial'?low/0.45359237:low,displayHigh=units==='imperial'?high/0.45359237:high,weightUnit=units==='imperial'?'lb':'kg';return{primary:bmi,unit:'kg/m²',status:category,interpretation:`BMI ${round(bmi)} falls in the CDC adult “${category}” screening category. BMI does not directly measure body fat or health.`,note:'Adult BMI can be less informative for athletes, pregnancy, older adults and some populations. Children and teens require age- and sex-specific percentiles.',metrics:[['BMI',String(round(bmi)),'Weight relative to height'],['Adult category',category,'CDC screening category'],['BMI Prime',String(round(bmi/25,2)),'BMI ÷ 25'],['BMI 18.5–24.9 weight',`${round(displayLow)}–${round(displayHigh)} ${weightUnit}`,'Height-based range']]}}
const bmr=10*weight+6.25*height-5*age+(sex==='male'?5:-161);if(op==='bmrAdvanced')return{primary:bmr,unit:'kcal/day',status:'Resting estimate',interpretation:`Estimated resting energy expenditure is ${Math.round(bmr)} kcal/day using the ${sex} Mifflin–St Jeor equation.`,note:'Prediction equations estimate group averages. Illness, pregnancy, medications, body composition and individual metabolism can change actual needs.',metrics:[['BMR',`${Math.round(bmr)} kcal/day`,'Resting estimate'],['Sedentary estimate',`${Math.round(bmr*1.2)} kcal/day`,'BMR × 1.2'],['Light activity',`${Math.round(bmr*1.375)} kcal/day`,'BMR × 1.375'],['Moderate activity',`${Math.round(bmr*1.55)} kcal/day`,'BMR × 1.55']]};const tdee=bmr*activity;return{primary:tdee,unit:'kcal/day',status:'Maintenance estimate',interpretation:`Estimated daily expenditure is ${Math.round(tdee)} kcal/day from BMR × ${activity}.`,note:'Activity multipliers are broad averages. Avoid treating a single estimate as a prescribed intake, especially with medical conditions or disordered-eating concerns.',metrics:[['TDEE',`${Math.round(tdee)} kcal/day`,'Maintenance estimate'],['BMR',`${Math.round(bmr)} kcal/day`,'Resting estimate'],['−250 planning case',`${Math.max(0,Math.round(tdee-250))} kcal/day`,'Illustrative only'],['+250 planning case',`${Math.round(tdee+250)} kcal/day`,'Illustrative only']]}}
document.querySelectorAll<HTMLElement>('[data-advanced-health]').forEach(root=>{const tool=JSON.parse(root.dataset.tool||'{}'),inputs=[...root.querySelectorAll<HTMLInputElement>('input[data-input-index]')],defaults=inputs.map(input=>input.defaultValue),unitSelect=root.querySelector<HTMLSelectElement>('[data-units]')!,sexSelect=root.querySelector<HTMLSelectElement>('[data-sex]'),activitySelect=root.querySelector<HTMLSelectElement>('[data-activity]'),output=root.querySelector<HTMLOutputElement>('output')!,toast=root.querySelector<HTMLElement>('[data-toast]')!;let units=new URLSearchParams(location.search).get('units')||localStorage.getItem('calcwise:health-units')||'metric';if(units==='imperial')unitSelect.value='imperial';else units='metric';const show=(text:string)=>{toast.textContent=text;toast.hidden=false;setTimeout(()=>toast.hidden=true,2000)};const syncLabels=()=>{root.querySelector<HTMLElement>('[data-field-label="0"]')!.textContent=`Weight (${units==='metric'?'kg':'lb'})`;root.querySelector<HTMLElement>('[data-field-label="1"]')!.textContent=`Height (${units==='metric'?'cm':'in'})`};const validate=()=>{let valid=true;inputs.forEach((input,index)=>{let message='';if(input.value==='')message='Enter a value.';else if(!Number.isFinite(Number(input.value))||Number(input.value)<=0)message='Enter a positive number.';input.setAttribute('aria-invalid',message?'true':'false');root.querySelector<HTMLElement>(`[data-error="${index}"]`)!.textContent=message;if(message)valid=false});return valid};const values=()=>inputs.map(input=>Number(input.value));const modelFor=(next=values())=>calculate(tool.op,next,sexSelect?.value||'female',Number(activitySelect?.value||1.55),units);const shareUrl=()=>{const url=new URL(location.href);inputs.forEach((input,index)=>url.searchParams.set(`v${index}`,input.value));url.searchParams.set('units',units);if(sexSelect)url.searchParams.set('sex',sexSelect.value);if(activitySelect)url.searchParams.set('activity',activitySelect.value);return url.toString()};const render=()=>{if(!validate()){output.textContent='—';return}const model=modelFor();output.textContent=tool.op==='bmiAdvanced'?model.primary.toFixed(1):String(Math.round(model.primary));root.querySelector<HTMLElement>('[data-unit]')!.textContent=model.unit;root.querySelector<HTMLElement>('[data-status]')!.textContent=model.status;root.querySelector<HTMLElement>('[data-interpretation]')!.textContent=model.interpretation;root.querySelector<HTMLElement>('[data-note]')!.textContent=model.note;model.metrics.forEach((row,index)=>{root.querySelector<HTMLElement>(`[data-metric-label="${index}"]`)!.textContent=row[0];root.querySelector<HTMLElement>(`[data-metric-value="${index}"]`)!.textContent=row[1];root.querySelector<HTMLElement>(`[data-metric-note="${index}"]`)!.textContent=row[2]});const base=values(),scenarioInputs:Array<[string,number]>=[['Lower weight',.95],['Current',1],['Higher weight',1.05]],suffix=tool.op==='bmiAdvanced'?' BMI':' kcal/day';root.querySelector<HTMLElement>('[data-scenarios]')!.innerHTML=scenarioInputs.map(([label,factor])=>{const next=[...base];next[0]*=factor;const result=modelFor(next).primary;return`<div class="scenario-row ${factor===1?'current':''}"><span>${label}<small>${factor===1?'Entered weight':`${factor<1?'−':'+'}5% weight`}</small></span><strong>${tool.op==='bmiAdvanced'?result.toFixed(1):Math.round(result)}${suffix}</strong></div>`}).join('');root.querySelector<HTMLElement>('[data-stamp]')!.textContent=`Updated ${new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}`};const params=new URLSearchParams(location.search);inputs.forEach((input,index)=>{const saved=params.get(`v${index}`);if(saved!==null)input.value=saved});if(sexSelect&&params.get('sex'))sexSelect.value=params.get('sex')!;if(activitySelect&&params.get('activity'))activitySelect.value=params.get('activity')!;syncLabels();unitSelect.addEventListener('change',()=>{const to=unitSelect.value;if(to===units)return;const weight=Number(inputs[0].value),height=Number(inputs[1].value);if(Number.isFinite(weight)&&Number.isFinite(height)){if(to==='imperial'){inputs[0].value=String(round(weight/0.45359237,1));inputs[1].value=String(round(height/2.54,1))}else{inputs[0].value=String(round(weight*0.45359237,1));inputs[1].value=String(round(height*2.54,1))}}units=to;localStorage.setItem('calcwise:health-units',units);syncLabels();render()});inputs.forEach(input=>input.addEventListener('input',render));sexSelect?.addEventListener('change',render);activitySelect?.addEventListener('change',render);root.querySelector('[data-reset]')?.addEventListener('click',()=>{inputs.forEach((input,index)=>input.value=defaults[index]);units='metric';unitSelect.value='metric';if(sexSelect)sexSelect.value='female';if(activitySelect)activitySelect.value='1.55';history.replaceState({},'',location.pathname);syncLabels();render();show('Calculator reset')});root.querySelector('[data-share]')?.addEventListener('click',async()=>{const url=shareUrl();try{if(navigator.share)await navigator.share({title:tool.title,text:`${tool.title}: ${output.textContent} ${root.querySelector<HTMLElement>('[data-unit]')!.textContent}`,url});else{await navigator.clipboard.writeText(url);show('Shareable result copied')}}catch{}});root.querySelector('[data-copy]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(`${tool.title}: ${output.textContent} ${root.querySelector<HTMLElement>('[data-unit]')!.textContent}\n${shareUrl()}`);show('Result and link copied')});root.querySelector('[data-print]')?.addEventListener('click',()=>print());render()});
</script>
