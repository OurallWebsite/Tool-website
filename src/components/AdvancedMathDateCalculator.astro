---
import type { Tool } from '../catalog';
import type { Lang } from '../site';
import '../styles/tool-detail.css';
import '../styles/calculator-preferences.css';
const { tool, lang }: { tool: Tool; lang: Lang } = Astro.props;
const isPercentage = tool.op === 'percentageAdvanced' || tool.op === 'percentChangeAdvanced';
const isAge = tool.op === 'ageAdvanced';
---
<section class="tool-workspace" data-advanced-math-date data-tool={JSON.stringify(tool)} data-lang={lang}>
  <div class="workspace-toolbar"><div class="live-state"><span class="live-dot"></span><strong>{isPercentage?'Multi-mode percentage solver':'Calendar-accurate date analysis'}</strong><small>Updates as you type</small></div><div class="tool-actions" role="group" aria-label="Calculator actions"><button type="button" class="action-btn" aria-label="Reset calculator" data-reset>↺ <span>Reset</span></button><button type="button" class="action-btn" aria-label="Share calculator" data-share>↗ <span>Share</span></button><button type="button" class="action-btn" aria-label="Copy result" data-copy>⧉ <span>Copy</span></button><button type="button" class="action-btn" aria-label="Print calculator" data-print>▣ <span>Print / PDF</span></button></div></div>
  {isPercentage&&<div class="preference-bar"><label for={`mode-${tool.slug}`}><span>Calculation mode</span><select id={`mode-${tool.slug}`} data-mode>{tool.op==='percentageAdvanced'?<><option value="percentOf">What is A% of B?</option><option value="whatPercent">A is what % of B?</option><option value="baseFromPercent">A is B% of what?</option><option value="increase">Increase A by B%</option><option value="decrease">Decrease A by B%</option><option value="points">Percentage-point difference A% → B%</option></>:<><option value="change">Relative change: old → new</option><option value="points">Percentage-point difference</option><option value="reverse">Reverse the change</option></>}</select></label><p>Percentage points measure the arithmetic difference between percentages; relative change divides by the starting value.</p></div>}
  {!isPercentage&&!isAge&&<div class="preference-bar"><label><span>Counting convention</span><select data-inclusive><option value="false">Exclusive — end minus start</option><option value="true">Inclusive — count both dates</option></select></label><p>Weekday totals count Monday–Friday and do not remove public holidays.</p></div>}
  <div class="calculator-stage"><div class="input-panel"><div class="panel-heading"><span class="step-number">01</span><div><strong>{isPercentage?'Values':'Calendar dates'}</strong><small>Choose a mode and enter the required values</small></div></div><div class="input-grid">{tool.inputs.map((input,index)=><label class="advanced-field"><span data-input-label={index}>{input.label}</span><div class="input-wrap"><input name={input.key} type={input.type||'number'} value={input.value} step={input.step||'any'} inputmode={input.type==='date'?undefined:'decimal'} required data-input-index={index}/><small>{input.help}</small></div><em data-error={index}></em></label>)}</div><p class="browser-note">🔒 Calculations run locally; values are not uploaded.</p></div><aside class="result-panel"><span class="result-kicker">Primary result</span><output aria-live="polite">—</output><strong class="result-unit" data-unit>{tool.unit}</strong><span class="result-status good" data-status>Calculation ready</span><p data-interpretation>Enter values to see the explanation.</p></aside></div>
  <section class="analytics-zone"><div class="section-heading-row"><div><span class="eyebrow">Detailed report</span><h2>{isPercentage?'Percentage relationships':'Calendar interval breakdown'}</h2></div><span class="calculation-stamp" data-stamp>Calculated now</span></div><div class="metric-grid">{[0,1,2,3].map(index=><article class="metric-card"><span data-metric-label={index}>Metric</span><strong data-metric-value={index}>—</strong><small data-metric-note={index}>Live calculation</small></article>)}</div><article class="analytics-card scenario-card"><div class="analytics-card-head"><div><span class="eyebrow">Explanation</span><h3 data-formula-heading>How this result is calculated</h3></div></div><p data-formula></p><div class="scenario-list" data-related></div></article></section>
  <div class="copy-toast" role="status" aria-live="polite" data-toast hidden>Copied</div>
</section>
<script>
type Row=[string,string,string];type Model={primary:string;unit:string;status:string;interpretation:string;formula:string;metrics:Row[];related:Row[]};
const number=(x:number)=>new Intl.NumberFormat(undefined,{maximumFractionDigits:6}).format(x);const pad=(x:number)=>String(x).padStart(2,'0');
const parseDate=(value:string)=>{const[y,m,d]=value.split('-').map(Number);return new Date(Date.UTC(y,m-1,d))};const iso=(date:Date)=>`${date.getUTCFullYear()}-${pad(date.getUTCMonth()+1)}-${pad(date.getUTCDate())}`;const days=(a:Date,b:Date)=>Math.round((b.getTime()-a.getTime())/864e5);const lastDay=(y:number,m:number)=>new Date(Date.UTC(y,m+1,0)).getUTCDate();
const addYears=(date:Date,n:number)=>new Date(Date.UTC(date.getUTCFullYear()+n,date.getUTCMonth(),Math.min(date.getUTCDate(),lastDay(date.getUTCFullYear()+n,date.getUTCMonth()))));const addMonths=(date:Date,n:number)=>{const total=date.getUTCFullYear()*12+date.getUTCMonth()+n,y=Math.floor(total/12),m=((total%12)+12)%12;return new Date(Date.UTC(y,m,Math.min(date.getUTCDate(),lastDay(y,m))))};
function calendarDiff(start:Date,end:Date){let years=end.getUTCFullYear()-start.getUTCFullYear();if(addYears(start,years)>end)years--;let anchor=addYears(start,years),months=0;while(addMonths(anchor,months+1)<=end)months++;anchor=addMonths(anchor,months);return{years,months,days:days(anchor,end)}}
function weekdays(start:Date,end:Date,inclusive:boolean){let count=0,cursor=new Date(start),stop=new Date(end);if(cursor>stop)[cursor,stop]=[stop,cursor];while(cursor<stop||(inclusive&&cursor<=stop)){const day=cursor.getUTCDay();if(day>0&&day<6)count++;cursor.setUTCDate(cursor.getUTCDate()+1)}return count}
function percentageModel(op:string,a:number,b:number,mode:string):Model{let result=0,unit='',formula='',interpretation='',metrics:Row[]=[];if(mode==='percentOf'){result=a/100*b;formula=`${a} ÷ 100 × ${b} = ${number(result)}`;interpretation=`${a}% of ${b} is ${number(result)}.`;metrics=[['Percentage',`${number(a)}%`,'Rate'],['Base value',number(b),'Whole'],['Result',number(result),'Part'],['Remaining',number(b-result),'Base minus result']]}else if(mode==='whatPercent'){result=a/b*100;unit='%';formula=`${a} ÷ ${b} × 100 = ${number(result)}%`;interpretation=`${a} is ${number(result)}% of ${b}.`;metrics=[['Part',number(a),'Numerator'],['Whole',number(b),'Denominator'],['Percentage',`${number(result)}%`,'Relative share'],['Fraction',number(a/b),'Part ÷ whole']]}else if(mode==='baseFromPercent'){result=a/(b/100);formula=`${a} ÷ (${b} ÷ 100) = ${number(result)}`;interpretation=`${a} is ${b}% of ${number(result)}.`;metrics=[['Known part',number(a),'Value A'],['Known percentage',`${number(b)}%`,'Value B'],['Recovered whole',number(result),'Base value'],['Check',number(result*b/100),'Should equal A']]}else if(mode==='increase'||mode==='decrease'){const sign=mode==='increase'?1:-1;result=a*(1+sign*b/100);formula=`${a} × (1 ${sign>0?'+':'−'} ${b} ÷ 100) = ${number(result)}`;interpretation=`${number(a)} ${mode==='increase'?'increased':'decreased'} by ${number(b)}% is ${number(result)}.`;metrics=[['Starting value',number(a),'Before change'],['Rate',`${number(b)}%`,mode],['Absolute change',number(Math.abs(result-a)),'Difference'],['Final value',number(result),'After change']]}else if(mode==='points'){result=b-a;unit='percentage points';const relative=a===0?NaN:(b-a)/a*100;formula=`${b}% − ${a}% = ${number(result)} percentage points`;interpretation=`The change from ${a}% to ${b}% is ${number(result)} percentage points${Number.isFinite(relative)?` and ${number(relative)}% relative change`:''}.`;metrics=[['Starting rate',`${number(a)}%`,'Old percentage'],['Ending rate',`${number(b)}%`,'New percentage'],['Point difference',number(result),'B − A'],['Relative change',Number.isFinite(relative)?`${number(relative)}%`:'Undefined','Divides by start']]}else{const change=(b-a)/a*100;result=mode==='reverse'?a/(1+b/100):change;unit=mode==='reverse'?'':'%';formula=mode==='reverse'?`${a} ÷ (1 + ${b} ÷ 100) = ${number(result)}`:`(${b} − ${a}) ÷ ${a} × 100 = ${number(result)}%`;interpretation=mode==='reverse'?`A final value of ${a} after a ${b}% change implies a starting value of ${number(result)}.`:`The value changed by ${number(result)}% from ${a} to ${b}.`;metrics=mode==='reverse'?[['Final value',number(a),'After change'],['Change rate',`${number(b)}%`,'Applied rate'],['Starting value',number(result),'Recovered base'],['Absolute change',number(a-result),'Final − start']]:[['Old value',number(a),'Starting point'],['New value',number(b),'Ending point'],['Absolute change',number(b-a),'New − old'],['Multiplier',number(b/a),'New ÷ old']]};if(!Number.isFinite(result)){return{primary:'—',unit,status:'Check inputs',interpretation:'This mode needs a non-zero denominator. Use a non-zero base value, whole value, starting value, or change rate as appropriate.',formula:'A non-zero denominator is required for this mode.',metrics:[],related:[]}}return{primary:number(result),unit,status:result>0?'Positive result':result<0?'Negative result':'Neutral result',interpretation,formula,metrics,related:metrics}}
function dateModel(op:string,first:string,second:string,inclusive:boolean):Model{const a=parseDate(first),b=parseDate(second);if(op==='ageAdvanced'){const diff=calendarDiff(a,b),total=days(a,b),thisYear=new Date(Date.UTC(b.getUTCFullYear(),a.getUTCMonth(),Math.min(a.getUTCDate(),lastDay(b.getUTCFullYear(),a.getUTCMonth())))),next=thisYear>b?thisYear:addYears(thisYear,1),until=days(b,next),primary=`${diff.years} years, ${diff.months} months, ${diff.days} days`;return{primary,unit:'exact calendar age',status:'Calendar age',interpretation:`From ${first} through ${second}, the complete calendar age is ${primary}.`,formula:'Complete years are counted first, then complete months, then remaining UTC calendar days.',metrics:[['Complete years',String(diff.years),'Calendar years'],['Total months',String(diff.years*12+diff.months),'Plus remaining days'],['Total days',number(total),'Elapsed days'],['Next birthday',`${iso(next)} (${until} days)`,'Calendar countdown']],related:[['Total weeks',`${Math.floor(total/7)} weeks + ${total%7} days`,'Elapsed'],['Birth weekday',a.toLocaleDateString(undefined,{weekday:'long',timeZone:'UTC'}),'UTC calendar'],['As-of weekday',b.toLocaleDateString(undefined,{weekday:'long',timeZone:'UTC'}),'UTC calendar']]}}
let start=a,end=b,direction='forward';if(start>end){[start,end]=[end,start];direction='reverse'}const effective=new Date(end);if(inclusive)effective.setUTCDate(effective.getUTCDate()+1);const total=days(start,effective),diff=calendarDiff(start,effective),weeks=Math.floor(total/7),remaining=total%7,weekdayCount=weekdays(start,end,inclusive),primary=`${diff.years} years, ${diff.months} months, ${diff.days} days`;return{primary,unit:inclusive?'inclusive interval':'elapsed interval',status:direction==='forward'?'Forward interval':'Dates reversed',interpretation:`The ${inclusive?'inclusive':'exclusive'} interval is ${primary}, or ${number(total)} total days.`,formula:inclusive?'End − start + 1 day; both boundary dates are counted.':'End − start; the starting boundary is not counted as a full elapsed day.',metrics:[['Total days',number(total),inclusive?'Inclusive':'Exclusive'],['Weeks + days',`${weeks} weeks + ${remaining} days`,'Whole weeks'],['Weekdays',number(weekdayCount),'Mon–Fri; no holidays'],['Direction',direction,'Input order']],related:[['Earlier date',iso(start),'Normalized'],['Later date',iso(end),'Normalized'],['Calendar interval',primary,'Years, months, days']]}}
document.querySelectorAll<HTMLElement>('[data-advanced-math-date]').forEach(root=>{const tool=JSON.parse(root.dataset.tool||'{}'),inputs=[...root.querySelectorAll<HTMLInputElement>('input[data-input-index]')],defaults=inputs.map(input=>input.defaultValue),mode=root.querySelector<HTMLSelectElement>('[data-mode]'),inclusive=root.querySelector<HTMLSelectElement>('[data-inclusive]'),output=root.querySelector<HTMLOutputElement>('output')!,toast=root.querySelector<HTMLElement>('[data-toast]')!;const params=new URLSearchParams(location.search);inputs.forEach((input,index)=>{const saved=params.get(`v${index}`);if(saved!==null)input.value=saved});if(mode&&params.get('mode'))mode.value=params.get('mode')!;if(inclusive&&params.get('inclusive'))inclusive.value=params.get('inclusive')!;const show=(text:string)=>{toast.textContent=text;toast.hidden=false;setTimeout(()=>toast.hidden=true,2000)};const validate=()=>{let valid=true;inputs.forEach((input,index)=>{const message=input.value===''?'Enter a value.':input.type==='number'&&!Number.isFinite(Number(input.value))?'Enter a valid number.':'';input.setAttribute('aria-invalid',message?'true':'false');root.querySelector<HTMLElement>(`[data-error="${index}"]`)!.textContent=message;if(message)valid=false});if(tool.op==='ageAdvanced'&&inputs[0].value&&inputs[1].value&&parseDate(inputs[0].value)>parseDate(inputs[1].value)){root.querySelector<HTMLElement>('[data-error="1"]')!.textContent='As-of date must be on or after birth date.';valid=false}return valid};const model=()=>tool.op==='percentageAdvanced'||tool.op==='percentChangeAdvanced'?percentageModel(tool.op,Number(inputs[0].value),Number(inputs[1].value),mode?.value||(tool.op==='percentChangeAdvanced'?'change':'percentOf')):dateModel(tool.op,inputs[0].value,inputs[1].value,inclusive?.value==='true');const shareUrl=()=>{const url=new URL(location.href);inputs.forEach((input,index)=>url.searchParams.set(`v${index}`,input.value));if(mode)url.searchParams.set('mode',mode.value);if(inclusive)url.searchParams.set('inclusive',inclusive.value);return url.toString()};const render=()=>{if(!validate()){output.textContent='—';return}const result=model();output.textContent=result.primary;root.querySelector<HTMLElement>('[data-unit]')!.textContent=result.unit;root.querySelector<HTMLElement>('[data-status]')!.textContent=result.status;root.querySelector<HTMLElement>('[data-interpretation]')!.textContent=result.interpretation;root.querySelector<HTMLElement>('[data-formula]')!.textContent=result.formula;result.metrics.forEach((row,index)=>{root.querySelector<HTMLElement>(`[data-metric-label="${index}"]`)!.textContent=row[0];root.querySelector<HTMLElement>(`[data-metric-value="${index}"]`)!.textContent=row[1];root.querySelector<HTMLElement>(`[data-metric-note="${index}"]`)!.textContent=row[2]});root.querySelector<HTMLElement>('[data-related]')!.innerHTML=result.related.map(row=>`<div class="scenario-row"><span>${row[0]}<small>${row[2]}</small></span><strong>${row[1]}</strong></div>`).join('');root.querySelector<HTMLElement>('[data-stamp]')!.textContent=`Updated ${new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}`};inputs.forEach(input=>input.addEventListener('input',render));mode?.addEventListener('change',render);inclusive?.addEventListener('change',render);root.querySelector('[data-reset]')?.addEventListener('click',()=>{inputs.forEach((input,index)=>input.value=defaults[index]);if(mode)mode.selectedIndex=0;if(inclusive)inclusive.value='false';history.replaceState({},'',location.pathname);render();show('Calculator reset')});root.querySelector('[data-share]')?.addEventListener('click',async()=>{const url=shareUrl();try{if(navigator.share)await navigator.share({title:tool.title,text:`${tool.title}: ${output.textContent}`,url});else{await navigator.clipboard.writeText(url);show('Shareable result copied')}}catch{}});root.querySelector('[data-copy]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(`${tool.title}: ${output.textContent} ${root.querySelector<HTMLElement>('[data-unit]')!.textContent}\n${shareUrl()}`);show('Result and link copied')});root.querySelector('[data-print]')?.addEventListener('click',()=>print());render()});
</script>
