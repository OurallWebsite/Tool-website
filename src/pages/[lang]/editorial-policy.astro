---
import Base from '../../layouts/Base.astro';
import { locales, path, type Lang } from '../../site';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base
  lang={lang}
  title="Editorial Policy | CalcWise"
  description="Learn how CalcWise creates, reviews and updates original calculator code, explanations and interface copy."
  pathname={path(lang, 'editorial-policy')}
>
  <article class="wrap page prose">
    <h1>Editorial Policy</h1>
    <p>All code, explanations and interface copy are original. We do not copy competitor articles or proprietary layouts. Pages are reviewed for clarity, formula accuracy, source suitability and conflicts of interest.</p>
    <h2>Transparency</h2>
    <p>Last updated 20 September 2026. Replace the placeholder domain, contact email and advertising identifiers before launch, and obtain local legal review for the jurisdictions you serve.</p>
  </article>
</Base>
