---
import Base from '../../layouts/Base.astro';
import { locales, path, type Lang } from '../../site';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base
  lang={lang}
  title="Disclaimer | CalcWise"
  description="Understand the limits of calculator estimates and when to seek qualified professional advice."
  pathname={path(lang, 'disclaimer')}
>
  <article class="wrap page prose">
    <h1>Disclaimer</h1>
    <p>Results are estimates and not professional advice. Formulas, rates, standards and regulations can change. Consult a qualified professional for consequential decisions.</p>
    <h2>Transparency</h2>
    <p>Last updated 20 September 2026. Replace the placeholder domain, contact email and advertising identifiers before launch, and obtain local legal review for the jurisdictions you serve.</p>
  </article>
</Base>
