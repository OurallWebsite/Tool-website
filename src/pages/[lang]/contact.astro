---
import Base from '../../layouts/Base.astro';
import { locales, path, type Lang } from '../../site';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base
  lang={lang}
  title="Contact | CalcWise"
  description="Contact CalcWise with questions, corrections, calculator feedback or partnership requests."
  pathname={path(lang, 'contact')}
>
  <article class="wrap page prose">
    <h1>Contact</h1>
    <p>Questions, corrections or partnership requests can be sent to hello@example.com. Include the calculator URL and the values used when reporting a possible error.</p>
    <h2>Transparency</h2>
    <p>Last updated 20 September 2026. Replace the placeholder domain, contact email and advertising identifiers before launch, and obtain local legal review for the jurisdictions you serve.</p>
  </article>
</Base>
