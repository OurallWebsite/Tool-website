---
import Base from '../../layouts/Base.astro';import {tools} from '../../catalog';import {SITE,locales,path,ui,type Lang} from '../../site';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang,u=ui[lang],defaultTool=tools.find(x=>x.slug==='mortgage-calculator')||tools[0];
const labels:Record<Lang,{tag:string;title:string;description:string;choose:string;copy:string;preview:string;note:string}>={en:{tag:'Free widget program',title:'Embed a CalcWise calculator',description:'Add a responsive calculator to your website at no cost. The widget stays updated from the CalcWise source.',choose:'Choose a calculator',copy:'Copy embed code',preview:'Live preview',note:'Please keep the CalcWise attribution visible. Inputs stay in the visitor’s browser.'},de:{tag:'Kostenloses Widget',title:'CalcWise-Rechner einbetten',description:'Füge deiner Website kostenlos einen responsiven Rechner hinzu.',choose:'Rechner auswählen',copy:'Embed-Code kopieren',preview:'Live-Vorschau',note:'Bitte die CalcWise-Nennung sichtbar lassen. Eingaben bleiben im Browser.'},fr:{tag:'Widget gratuit',title:'Intégrer un calculateur CalcWise',description:'Ajoutez gratuitement un calculateur adaptatif à votre site.',choose:'Choisir un calculateur',copy:'Copier le code',preview:'Aperçu',note:'Conservez l’attribution CalcWise visible. Les données restent dans le navigateur.'},it:{tag:'Widget gratuito',title:'Integra un calcolatore CalcWise',description:'Aggiungi gratuitamente un calcolatore responsive al tuo sito.',choose:'Scegli un calcolatore',copy:'Copia codice',preview:'Anteprima',note:'Mantieni visibile l’attribuzione CalcWise. I dati restano nel browser.'},ja:{tag:'無料ウィジェット',title:'CalcWise計算ツールを埋め込む',description:'レスポンシブな計算ツールを無料でサイトに追加できます。',choose:'計算ツールを選択',copy:'コードをコピー',preview:'プレビュー',note:'CalcWiseの帰属表示を残してください。入力はブラウザ内に保存されます。'},es:{tag:'Widget gratuito',title:'Insertar una calculadora CalcWise',description:'Añade gratis una calculadora adaptable a tu sitio web.',choose:'Elegir calculadora',copy:'Copiar código',preview:'Vista previa',note:'Mantén visible la atribución de CalcWise. Los datos permanecen en el navegador.'},pt:{tag:'Widget gratuito',title:'Incorporar uma calculadora CalcWise',description:'Adicione gratuitamente uma calculadora responsiva ao seu site.',choose:'Escolher calculadora',copy:'Copiar código',preview:'Prévia',note:'Mantenha a atribuição CalcWise visível. Os dados ficam no navegador.'}};const l=labels[lang];
---
<Base lang={lang} title={`${l.title} | CalcWise`} description={l.description} pathname={path(lang,'embed')}><section class="wrap page"><nav class="crumbs"><a href={path(lang)}>{u.home}</a> / {l.title}</nav><div class="page-head"><p class="eyebrow">{l.tag}</p><h1>{l.title}</h1><p class="muted">{l.description}</p></div><div class="embed-builder" data-builder data-domain={SITE.domain} data-lang={lang}><label class="field"><span>{l.choose}</span><select data-tool>{tools.map(tool=><option value={`${tool.category}/${tool.slug}`} selected={tool.slug===defaultTool.slug}>{tool.title}</option>)}</select></label><label class="field"><span>HTML</span><textarea data-code rows="5" readonly></textarea></label><button class="btn primary" type="button" data-copy>{l.copy}</button><p class="muted">{l.note}</p><h2>{l.preview}</h2><div data-preview></div></div></section><style>.embed-builder{max-width:900px;padding:26px;border:1px solid var(--line);border-radius:20px;background:#fff}.embed-builder select,.embed-builder textarea{width:100%;padding:13px;border:1px solid #cbd0cc;border-radius:10px;background:#fafbf9}.embed-builder textarea{font-family:ui-monospace,monospace}.embed-builder h2{font-size:1.7rem;margin:36px 0 16px}.embed-builder iframe{width:100%;height:720px;border:1px solid var(--line);border-radius:16px}</style><script>document.querySelectorAll<HTMLElement>('[data-builder]').forEach(root=>{const select=root.querySelector<HTMLSelectElement>('[data-tool]')!,code=root.querySelector<HTMLTextAreaElement>('[data-code]')!,preview=root.querySelector<HTMLElement>('[data-preview]')!,domain=root.dataset.domain!,lang=root.dataset.lang!;const render=()=>{const url=`${domain}/${lang}/${select.value}/`;code.value=`<script async src="${domain}/embed.js" data-calcwise="${url}" data-title="CalcWise calculator"><\/script>`;preview.innerHTML=`<iframe title="CalcWise calculator preview" loading="lazy" src="${url}?embed=1"></iframe>`};select.addEventListener('change',render);root.querySelector('[data-copy]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(code.value);const b=root.querySelector<HTMLButtonElement>('[data-copy]')!;const old=b.textContent;b.textContent='Copied';setTimeout(()=>b.textContent=old,1800)});render()});</script></Base>
