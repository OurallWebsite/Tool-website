---
import Base from '../../../layouts/Base.astro';
import Calculator from '../../../components/Calculator.astro';
import ToolCard from '../../../components/ToolCard.astro';
import { tools, findTool, byCategory } from '../../../catalog';
import { SITE, locales, categories, ui, path, type Lang, type Category } from '../../../site';

export function getStaticPaths() {
  return locales.flatMap((lang) => tools.map((tool) => ({
    params: { lang, category: tool.category, slug: tool.slug },
  })));
}

const lang = Astro.params.lang as Lang;
const category = Astro.params.category as Category;
const slug = Astro.params.slug!;
const tool = findTool(category, slug)!;
const u = ui[lang];
const pathname = path(lang, `${category}/${slug}`);
const related = byCategory(category).filter((item) => item.slug !== slug).slice(0, 4);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.title,
    description: tool.description,
    url: new URL(pathname, SITE.domain).toString(),
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: u.home, item: path(lang) },
      { name: categories[category][lang], item: path(lang, category) },
      { name: tool.title, item: pathname },
    ].map((item, index) => ({ '@type': 'ListItem', position: index + 1, ...item })),
  },
];
---

<Base lang={lang} title={`${tool.title} — Free, instant & accurate | CalcWise`} description={tool.description} pathname={pathname} jsonld={schema}>
  <article class="wrap page">
    <nav class="crumbs"><a href={path(lang)}>{u.home}</a> / <a href={path(lang, category)}>{categories[category][lang]}</a> / {tool.title}</nav>
    <header class="page-head">
      <span class="chip">{categories[category][lang]}</span>
      <h1>{tool.title}</h1>
      <p class="muted">{tool.description} Reviewed 20 September 2026.</p>
    </header>
    <Calculator tool={tool} lang={lang} />
    <div class="ad" aria-label="Advertisement">Advertisement placeholder</div>
    <section class="prose">
      <h2>{u.formula}</h2>
      <p>This calculator applies the following established relationship to the values you enter. Keep units consistent unless the fields specify otherwise.</p>
      <p class="formula">{tool.formula}</p>
      <h2>{u.example}</h2>
      <p>Replace the sample values with your own. The result updates instantly in your browser. For consequential decisions, independently verify critical inputs and consult a qualified professional when appropriate.</p>
      <h2>Accuracy and sources</h2>
      <p>Conversion factors use international unit definitions. Formula-based tools state their equation above so results can be checked independently. Rounding affects display only; calculations use full browser precision.</p>
    </section>
    <section class="section">
      <h2>{u.related}</h2>
      <div class="tool-grid">{related.map((item) => <ToolCard tool={item} lang={lang} />)}</div>
    </section>
  </article>
</Base>
