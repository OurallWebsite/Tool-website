---
import Base from '../../../layouts/Base.astro';import Calculator from '../../../components/Calculator.astro';import AdvancedFinanceCalculator from '../../../components/AdvancedFinanceCalculator.astro';import AdvancedHealthCalculator from '../../../components/AdvancedHealthCalculator.astro';import AdvancedMathDateCalculator from '../../../components/AdvancedMathDateCalculator.astro';import AdvancedConstructionBusinessCalculator from '../../../components/AdvancedConstructionBusinessCalculator.astro';import AdvancedEducationScienceCalculator from '../../../components/AdvancedEducationScienceCalculator.astro';import AdvancedRemainingCalculator from '../../../components/AdvancedRemainingCalculator.astro';import ToolCard from '../../../components/ToolCard.astro';import {tools,findTool,byCategory} from '../../../catalog';import {SITE,locales,categories,ui,path,type Lang,type Category} from '../../../site';
export function getStaticPaths(){return locales.flatMap(lang=>tools.map(tool=>({params:{lang,category:tool.category,slug:tool.slug}})))}
const lang=Astro.params.lang as Lang,category=Astro.params.category as Category,slug=Astro.params.slug!,tool=findTool(category,slug)!,u=ui[lang],pathname=path(lang,`${category}/${slug}`),related=byCategory(category).filter(x=>x.slug!==slug).slice(0,4),categoryName=categories[category][lang],advancedHealth=['bmiAdvanced','bmrAdvanced','tdeeAdvanced'].includes(tool.op),advancedMathDate=['percentageAdvanced','percentChangeAdvanced','ageAdvanced','dateDiffAdvanced'].includes(tool.op),advancedConstructionBusiness=['squareFootageAdvanced','concreteAdvanced','profitMarginAdvanced','breakEvenAdvanced'].includes(tool.op),advancedEduScience=category==='education'||category==='science',advancedRemaining=['paint-calculator','brick-calculator','roof-pitch-calculator','markup-calculator','cagr-calculator','customer-acquisition-cost-calculator','customer-lifetime-value-calculator','conversion-rate-calculator','inventory-turnover-calculator'].includes(tool.slug);
const context={finance:['turn financial assumptions into a planning estimate','Rates, fees and market conditions can change results.'],health:['translate measurements into an educational health estimate','Health calculations do not replace clinical assessment.'],math:['solve percentage relationships with transparent steps','Percentage points and relative percentage change differ.'],'date-time':['calculate calendar relationships','Counting conventions and time zones can change interpretation.'],construction:['estimate quantities, purchasing units and material cost','Verify measurements, waste and supplier data before purchasing.'],business:['model profitability and break-even','Use complete costs and realistic volume assumptions.'],education:['model grades, study targets and academic outcomes','Official institutional weighting and rounding policies take precedence.'],science:['apply scientific equations with visible variables and units','Unit consistency and measurement uncertainty affect results.'],converters:['convert between measurement standards','Round only at the final step.']}[category];const inputDescriptions=tool.inputs.map((x,i)=>({label:x.label,description:x.help||`${x.label} is used directly in the displayed formula.`,position:i+1})),faq=[{q:`What does the ${tool.title} calculate?`,a:`It uses ${tool.formula} to ${context[0]}.`},{q:`Is the ${tool.title} free?`,a:'Yes. It is free, needs no account and calculates locally.'},{q:'How accurate is it?',a:`Full browser precision is used before display rounding. ${context[1]}`},{q:'Can I share the result?',a:'Yes. Use Copy or Share to preserve the scenario.'}],schema=[{'@context':'https://schema.org','@type':'WebApplication',name:tool.title,description:tool.description,url:new URL(pathname,SITE.domain).toString(),applicationCategory:'UtilitiesApplication',operatingSystem:'Any',isAccessibleForFree:true},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(x=>({'@type':'Question',name:x.q,acceptedAnswer:{'@type':'Answer',text:x.a}}))}];
---
<Base lang={lang} title={`${tool.title} — Free, instant & accurate | ${SITE.name}`} description={tool.description} pathname={pathname} jsonld={schema}><article class="wrap page"><nav class="crumbs"><a href={path(lang)}>{u.home}</a> / <a href={path(lang,category)}>{categoryName}</a> / {tool.title}</nav><header class="page-head advanced-head"><span class="chip">{categories[category].icon} {categoryName}</span><h1>{tool.title}</h1><p class="muted">{tool.description}</p><div class="tool-meta-row"><span>✓ Formula shown</span><span>✓ Private calculation</span><span>✓ Live analytics</span><span>✓ Shareable scenario</span></div></header>{advancedHealth?<AdvancedHealthCalculator tool={tool} lang={lang}/>:advancedMathDate?<AdvancedMathDateCalculator tool={tool} lang={lang}/>:advancedConstructionBusiness?<AdvancedConstructionBusinessCalculator tool={tool} lang={lang}/>:advancedRemaining?<AdvancedRemainingCalculator tool={tool} lang={lang}/>:advancedEduScience?<AdvancedEducationScienceCalculator tool={tool} lang={lang}/>:tool.advanced?<AdvancedFinanceCalculator tool={tool} lang={lang}/>:<Calculator tool={tool} lang={lang}/>}<div class="ad" aria-label="Advertisement">Advertisement placeholder</div><div class="tool-content-grid"><main class="tool-article prose"><section class="quick-answer" id="overview"><strong>Quick answer</strong><p>The {tool.title} helps you {context[0]}. Adjust inputs above for an instant report.</p></section><section id="meaning"><h2>What this calculator tells you</h2><p>{tool.description}</p><p>{context[1]}</p></section><section id="formula"><h2>{u.formula}</h2><p class="formula">{tool.formula}</p><p>Full precision is retained internally and display rounding is applied at the end.</p></section><section id="instructions"><h2>How to use the {tool.title}</h2><ol><li>Enter values in the stated units.</li><li>Review the primary result and supporting metrics.</li><li>Test the sensitivity scenarios.</li><li>Check the visible method and limitation.</li><li>Copy, share or print the result.</li></ol></section><section id="inputs"><h2>What each input means</h2><div class="input-glossary">{inputDescriptions.map(x=><article><span>{String(x.position).padStart(2,'0')}</span><div><h3>{x.label}</h3><p>{x.description}</p></div></article>)}</div></section><section id="example"><h2>Worked input example</h2><div class="input-summary">{tool.inputs.map(x=><div><span>{x.label}</span><strong>{x.value}</strong></div>)}</div><p>Change any input to model your own scenario.</p></section><section id="analytics"><h2>How to understand the result</h2><p>Use the primary answer together with converted values, supporting metrics and sensitivity cases. Do not treat an isolated rounded value as more precise than its inputs.</p></section><section id="assumptions"><h2>Important information and limitations</h2><ul><li>Inputs must use the stated units and assumptions.</li><li>Zero denominators and impossible targets may produce an unavailable result or warning.</li><li>{context[1]}</li></ul></section><section id="faq"><h2>Frequently asked questions</h2><div class="faq-list">{faq.map((x,i)=><details open={i===0}><summary>{x.q}</summary><p>{x.a}</p></details>)}</div></section><section id="methodology"><h2>Accuracy, privacy and methodology</h2><p>Calculations run locally. Inputs are not uploaded. Formulas, assumptions and limitations are visible for independent verification.</p></section></main><aside class="detail-sidebar"><nav class="detail-nav"><strong>On this page</strong><a href="#overview">Quick answer</a><a href="#formula">Formula</a><a href="#instructions">How to use</a><a href="#inputs">Input guide</a><a href="#example">Example</a><a href="#assumptions">Limitations</a><a href="#faq">FAQs</a></nav><div class="trust-card"><strong>Transparent by design</strong><p>No account, no uploaded inputs and visible formulas.</p></div></aside></div><section class="section"><h2>{u.related}</h2><div class="tool-grid">{related.map(item=><ToolCard tool={item} lang={lang}/>)}</div></section></article></Base>
