---
import Base from '../../../layouts/Base.astro';import Calculator from '../../../components/Calculator.astro';import AdvancedFinanceCalculator from '../../../components/AdvancedFinanceCalculator.astro';import AdvancedHealthCalculator from '../../../components/AdvancedHealthCalculator.astro';import AdvancedMathDateCalculator from '../../../components/AdvancedMathDateCalculator.astro';import AdvancedConstructionBusinessCalculator from '../../../components/AdvancedConstructionBusinessCalculator.astro';import ToolCard from '../../../components/ToolCard.astro';import { tools, findTool, byCategory } from '../../../catalog';import { SITE, locales, categories, ui, path, type Lang, type Category } from '../../../site';
export function getStaticPaths(){return locales.flatMap(lang=>tools.map(tool=>({params:{lang,category:tool.category,slug:tool.slug}})))}
const lang=Astro.params.lang as Lang,category=Astro.params.category as Category,slug=Astro.params.slug!,tool=findTool(category,slug)!,u=ui[lang],pathname=path(lang,`${category}/${slug}`),related=byCategory(category).filter(item=>item.slug!==slug).slice(0,4),categoryName=categories[category][lang],advancedHealth=['bmiAdvanced','bmrAdvanced','tdeeAdvanced'].includes(tool.op),advancedMathDate=['percentageAdvanced','percentChangeAdvanced','ageAdvanced','dateDiffAdvanced'].includes(tool.op),advancedConstructionBusiness=['squareFootageAdvanced','concreteAdvanced','profitMarginAdvanced','breakEvenAdvanced'].includes(tool.op);
const context={finance:{purpose:'turn financial assumptions into a clear planning estimate',audience:'households, investors, borrowers and financial planners',caution:'Rates, fees, taxes and market conditions can change the real outcome.'},health:{purpose:'translate adult measurements into an educational screening or energy estimate',audience:'adults exploring general health and energy indicators',caution:'Health calculations are estimates and cannot replace clinical assessment.'},math:{purpose:'solve percentage relationships with transparent, repeatable steps',audience:'students, teachers, professionals and everyday problem-solvers',caution:'Distinguish percentage-point differences from relative percentage change.'},'date-time':{purpose:'calculate calendar relationships accurately',audience:'people planning schedules, deadlines, events and records',caution:'Inclusive counting, input order, holidays and time zones can change interpretation.'},construction:{purpose:'estimate project quantities, purchasing units and material cost',audience:'homeowners, contractors, estimators and DIY planners',caution:'Verify site measurements, waste, supplier coverage and local requirements before purchasing.'},business:{purpose:'turn revenue and cost assumptions into profitability and break-even metrics',audience:'founders, analysts, marketers and operations teams',caution:'Use complete costs and realistic volume and price assumptions.'},education:{purpose:'model grades, study targets and academic outcomes',audience:'students, teachers and academic advisers',caution:'Your institution’s official weighting and rounding policy takes precedence.'},science:{purpose:'apply a scientific equation with visible variables and units',audience:'students, researchers, engineers and technical users',caution:'Measurement uncertainty and unit consistency can materially affect the answer.'},converters:{purpose:'convert a value between two measurement standards instantly',audience:'students, professionals, travelers and technical users',caution:'Retain sufficient precision and round only at the final step.'}}[category];
const inputDescriptions=tool.inputs.map((input,index)=>({label:input.label,description:input.help||`${input.label} is ${input.type==='date'?'the calendar date used by the formula':'a numeric value used directly in the stated formula'}. Enter a realistic value.`,position:index+1})),exampleInputs=tool.inputs.map(input=>`${input.label}: ${input.value}`).join('; ');const faq=[{q:`What does the ${tool.title} calculate?`,a:`It uses ${tool.formula} to ${context.purpose}. The result updates instantly when an input changes.`},{q:`Is the ${tool.title} free?`,a:'Yes. It is free, requires no account and processes values locally in your browser.'},{q:'How accurate is the result?',a:`The browser calculates with full precision and rounds only the displayed answer. ${context.caution}`},{q:'Can I save or share my calculation?',a:'Yes. Share and Copy create a URL containing the current scenario.'}];const schema=[{'@context':'https://schema.org','@type':'WebApplication',name:tool.title,description:tool.description,url:new URL(pathname,SITE.domain).toString(),applicationCategory:'UtilitiesApplication',operatingSystem:'Any',isAccessibleForFree:true,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:u.home,item:path(lang)},{name:categoryName,item:path(lang,category)},{name:tool.title,item:pathname}].map((item,index)=>({'@type':'ListItem',position:index+1,...item}))},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(item=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}}))}];
---
<Base lang={lang} title={`${tool.title} — Free, instant & accurate | ${SITE.name}`} description={tool.description} pathname={pathname} jsonld={schema}><article class="wrap page"><nav class="crumbs"><a href={path(lang)}>{u.home}</a> / <a href={path(lang,category)}>{categoryName}</a> / {tool.title}</nav><header class="page-head advanced-head"><span class="chip">{categories[category].icon} {categoryName}</span><h1>{tool.title}</h1><p class="muted">{tool.description} Built for {context.audience}.</p><div class="tool-meta-row"><span>✓ Formula shown</span><span>✓ Private calculation</span><span>✓ Live analytics</span><span>✓ Shareable scenario</span></div></header>{advancedHealth?<AdvancedHealthCalculator tool={tool} lang={lang}/>:advancedMathDate?<AdvancedMathDateCalculator tool={tool} lang={lang}/>:advancedConstructionBusiness?<AdvancedConstructionBusinessCalculator tool={tool} lang={lang}/>:tool.advanced?<AdvancedFinanceCalculator tool={tool} lang={lang}/>:<Calculator tool={tool} lang={lang}/>}<div class="ad" aria-label="Advertisement">Advertisement placeholder</div>
<div class="tool-content-grid"><main class="tool-article prose"><section class="quick-answer" id="overview"><strong>Quick answer</strong><p>The {tool.title} helps you {context.purpose}. Adjust values and options above; the report updates immediately.</p></section><section id="meaning"><h2>What this calculator tells you</h2><p>{tool.description} It is designed for {context.audience}. Read the primary result with supporting metrics and limitations.</p><p>{context.caution}</p></section><section id="formula"><h2>{u.formula}</h2><p class="formula">{tool.formula}</p><p>Full browser precision is retained; rounding is applied only to displayed answers and required purchasing units.</p></section><section id="instructions"><h2>How to use the {tool.title}</h2><ol><li>Select relevant units or scenario options.</li><li>Enter accurate measurements, revenue or cost assumptions.</li><li>Review the primary result and supporting metrics.</li><li>Confirm waste, supplier, pricing and cost assumptions.</li><li>Copy, share or print the scenario.</li></ol></section><section id="inputs"><h2>What each input means</h2><div class="input-glossary">{inputDescriptions.map(item=><article><span>{String(item.position).padStart(2,'0')}</span><div><h3>{item.label}</h3><p>{item.description}</p></div></article>)}</div>{(category==='finance'||category==='business'||category==='construction')&&<p><strong>Currency preference:</strong> denomination and formatting only; no live FX conversion.</p>}</section><section id="example"><h2>Worked input example</h2><div class="input-summary">{tool.inputs.map(input=><div><span>{input.label}</span><strong>{input.value}</strong></div>)}</div><p>Example input set: {exampleInputs}. Change any field for your scenario.</p></section><section id="analytics"><h2>How to understand the result</h2><p>The main answer is supported by quantities, costs, margins or scenario comparisons. Purchasing quantities are rounded up only where whole packages or units are required.</p></section><section id="assumptions"><h2>Important information and limitations</h2>{advancedConstructionBusiness?<ul><li>Measurements, supplier coverage, waste and price inputs must use the selected units.</li><li>Construction estimates do not replace site measurement or supplier advice.</li><li>Business scenarios assume prices and costs remain constant across the modeled range.</li><li>{context.caution}</li></ul>:advancedHealth?<ul><li>BMI is an adult screening measure.</li><li>BMR and TDEE are predictive estimates.</li><li>{context.caution}</li></ul>:advancedMathDate?<ul><li>Percentage points and relative change differ.</li><li>Weekday totals exclude public holidays.</li><li>{context.caution}</li></ul>:<ul><li>Inputs must match stated units and assumptions.</li><li>{context.caution}</li></ul>}</section><section id="faq"><h2>Frequently asked questions</h2><div class="faq-list">{faq.map((item,index)=><details open={index===0}><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section><section id="methodology"><h2>Accuracy, privacy and methodology</h2><p>Visible formulas and assumptions describe the browser-local calculation. Inputs are not uploaded. Verify consequential purchasing and business decisions independently.</p></section></main><aside class="detail-sidebar"><nav class="detail-nav"><strong>On this page</strong><a href="#overview">Quick answer</a><a href="#meaning">What it tells you</a><a href="#formula">Formula</a><a href="#instructions">How to use</a><a href="#inputs">Input guide</a><a href="#example">Worked example</a><a href="#analytics">Result guide</a><a href="#assumptions">Limitations</a><a href="#faq">FAQs</a></nav><div class="trust-card"><strong>Transparent by design</strong><p>No account, no uploaded inputs, visible formulas and explicit assumptions.</p></div></aside></div><section class="section"><h2>{u.related}</h2><div class="tool-grid">{related.map(item=><ToolCard tool={item} lang={lang}/>)}</div></section></article></Base>
