---
import Base from '../../layouts/Base.astro';
import { locales, path, type Lang } from '../../site';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base
  lang={lang}
  title="Cookie Policy | CalcWise"
  description="Learn how CalcWise uses essential storage and optional analytics or advertising technologies."
  pathname={path(lang, 'cookies')}
>
  <article class="wrap page prose">
    <h1>Cookie Policy</h1>
    <p>Essential storage remembers your consent choice. Optional analytics and advertising technologies are activated only where configured and permitted after consent.</p>
    <h2>Transparency</h2>
    <p>Last updated 20 September 2026. Replace the placeholder domain, contact email and advertising identifiers before launch, and obtain local legal review for the jurisdictions you serve.</p>
  </article>
</Base>
