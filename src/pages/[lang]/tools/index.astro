---
import Base from '../../../layouts/Base.astro';
import ToolCard from '../../../components/ToolCard.astro';
import { tools } from '../../../catalog';
import { locales, ui, path, type Lang } from '../../../site';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const u = ui[lang];
---

<Base
  lang={lang}
  title={`${u.all} — 400 calculators | CalcWise`}
  description={u.sub}
  pathname={path(lang, 'tools')}
>
  <section class="wrap page">
    <p class="eyebrow">400 calculators</p>
    <h1>{u.all}</h1>
    <form class="search" action={path(lang, 'search')}>
      <input name="q" placeholder={u.search} />
      <button class="btn primary">{u.search}</button>
    </form>
    <div class="tool-grid section">
      {tools.map((tool) => <ToolCard tool={tool} lang={lang} />)}
    </div>
  </section>
</Base>
