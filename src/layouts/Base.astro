---
import '../styles/global.css';import {SITE,locales,localeNames,ui,path,categories,type Lang} from '../site';
const {lang='en',title,description,pathname,jsonld=[]}:{lang:Lang,title:string,description:string,pathname:string,jsonld?:any[]}=Astro.props;const canonical=new URL(pathname,SITE.domain);const switchPath=(l:Lang)=>pathname.replace(/^\/[a-z]{2}\//,`/${l}/`);const u=ui[lang];const parts=pathname.split('/').filter(Boolean);const toolPage=parts.length===3&&parts[1] in categories;const ogImage=new URL(toolPage?`/og/${parts[1]}/${parts[2]}.svg`:'/og.png',SITE.domain);
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"/><link rel="canonical" href={canonical}/>{locales.map(l=><link rel="alternate" hreflang={l} href={new URL(switchPath(l),SITE.domain)}/>)}<link rel="alternate" hreflang="x-default" href={new URL(switchPath('en'),SITE.domain)}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/><meta name="theme-color" content="#14221d"/>{jsonld.map(x=><script type="application/ld+json" set:html={JSON.stringify(x)}/>)}<link rel="sitemap" href="/sitemap.xml"/><script is:inline>(()=>{const q=new URLSearchParams(location.search);if(q.get('embed')==='1'){document.documentElement.dataset.embed='true';addEventListener('DOMContentLoaded',()=>{document.querySelector('meta[name="robots"]')?.setAttribute('content','noindex,follow');const send=()=>parent.postMessage({type:'calcwise:resize',id:q.get('embedId')||'',height:document.documentElement.scrollHeight},'*');new ResizeObserver(send).observe(document.body);send()})}})();</script><style is:global>html[data-embed="true"] body{background:#fff}html[data-embed="true"] .topbar,html[data-embed="true"] .header,html[data-embed="true"] .footer,html[data-embed="true"] .cookie,html[data-embed="true"] .crumbs,html[data-embed="true"] .page-head,html[data-embed="true"] .ad,html[data-embed="true"] .tool-content-grid,html[data-embed="true"] article.page>.section{display:none!important}html[data-embed="true"] .page{width:100%;padding:0}html[data-embed="true"] .tool-workspace{margin:0;border:0;border-radius:0;box-shadow:none}</style></head><body><a class="skip" href="#main">Skip to content</a><div class="topbar">Free • private • no account required</div><header class="header"><nav class="nav wrap" aria-label="Primary"><a class="logo" href={path(lang)}><b>+</b>CalcWise</a><div class="links"><a href={path(lang,'tools')}>{u.all}</a><a href={path(lang,'collections')}>Collections</a><a href={path(lang,'about')}>About</a></div><select class="lang" aria-label={u.language} onchange="location.href=this.value">{locales.map(l=><option value={switchPath(l)} selected={l===lang}>{localeNames[l]}</option>)}</select></nav></header><main id="main"><slot/></main><footer class="footer"><div class="wrap footgrid"><div><a class="logo" href={path(lang)}><b>+</b>CalcWise</a><p>Original, formula-led calculators for everyday decisions.</p></div><div><strong>Explore</strong><a href={path(lang,'tools')}>{u.all}</a><a href={path(lang,'collections')}>Collections</a><a href={path(lang,'embed')}>Embed a calculator</a><a href={path(lang,'methodology')}>Methodology</a><a href={path(lang,'editorial-policy')}>Editorial policy</a></div><div><strong>Company</strong><a href={path(lang,'about')}>About</a><a href={path(lang,'contact')}>Contact</a><a href={path(lang,'privacy')}>Privacy</a><a href={path(lang,'terms')}>Terms</a><a href={path(lang,'cookies')}>Cookies</a><a href={path(lang,'disclaimer')}>Disclaimer</a></div></div></footer><div class="cookie" data-cookie><p>We use optional advertising cookies only after consent. Calculator inputs never leave your browser.</p><button class="btn primary" data-accept>Accept optional cookies</button> <button class="btn" data-reject>Reject</button></div><script>const box=document.querySelector('[data-cookie]');if(localStorage.getItem('consent'))box?.setAttribute('hidden','');document.querySelector('[data-accept]')?.addEventListener('click',()=>{localStorage.setItem('consent','yes');box?.setAttribute('hidden','')});document.querySelector('[data-reject]')?.addEventListener('click',()=>{localStorage.setItem('consent','no');box?.setAttribute('hidden','')});</script></body></html>
