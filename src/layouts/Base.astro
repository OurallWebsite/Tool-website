---
import '../styles/global.css';
import { SITE, locales, localeNames, ui, path, categories, type Lang } from '../site';

const {
  lang = 'en',
  title,
  description,
  pathname,
  jsonld = [],
}: { lang: Lang; title: string; description: string; pathname: string; jsonld?: Record<string, unknown>[] } = Astro.props;

const canonical = new URL(pathname, SITE.domain);
const switchPath = (locale: Lang) => pathname.replace(/^\/[a-z]{2}\//, `/${locale}/`);
const u = ui[lang];
const parts = pathname.split('/').filter(Boolean);
const toolPage = parts.length === 3 && parts[1] in categories;
const ogImage = new URL(toolPage ? `/og/${parts[1]}/${parts[2]}.svg` : '/og.png', SITE.domain);
const metaDescription = description.length > 160 ? `${description.slice(0, 157).replace(/\s+\S*$/, '')}…` : description;
const sharedSchema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE.domain}/#organization`,
    name: SITE.name,
    url: SITE.domain,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.domain}/#website`,
    name: SITE.name,
    url: SITE.domain,
    publisher: { '@id': `${SITE.domain}/#organization` },
    potentialAction: {
      '@type': 'SearchAction',
      target: `${SITE.domain}/${lang}/search/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="canonical" href={canonical.toString()} />
    {locales.map((locale) => <link rel="alternate" hreflang={locale} href={new URL(switchPath(locale), SITE.domain).toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchPath('en'), SITE.domain).toString()} />
    <link rel="alternate" type="text/plain" href={new URL('/llms.txt', SITE.domain).toString()} title="LLM-readable site index" />
    <meta name="author" content={SITE.name} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="og:image:alt" content={`${title} — ${SITE.name}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage.toString()} />
    <meta name="theme-color" content="#14221d" />
    { [...sharedSchema, ...jsonld].map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />) }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        ad_storage: 'denied', analytics_storage: 'denied', ad_user_data: 'denied',
        ad_personalization: 'denied', functionality_storage: 'granted', security_storage: 'granted',
        wait_for_update: 500,
      });
    </script>
    <script is:inline>
      (() => {
        const q = new URLSearchParams(location.search);
        if (q.get('embed') === '1') {
          document.documentElement.dataset.embed = 'true';
          addEventListener('DOMContentLoaded', () => {
            document.querySelector('meta[name="robots"]')?.setAttribute('content', 'noindex,follow');
            const send = () => parent.postMessage({ type: 'calcwise:resize', id: q.get('embedId') || '', height: document.documentElement.scrollHeight }, '*');
            new ResizeObserver(send).observe(document.body);
            send();
          });
        }
      })();
    </script>
    <style is:global>
      html[data-embed="true"] body { background: #fff }
      html[data-embed="true"] .topbar, html[data-embed="true"] .header, html[data-embed="true"] .footer,
      html[data-embed="true"] .cookie, html[data-embed="true"] .crumbs, html[data-embed="true"] .page-head,
      html[data-embed="true"] .ad, html[data-embed="true"] .tool-content-grid,
      html[data-embed="true"] article.page > .section { display: none !important }
      html[data-embed="true"] .page { width: 100%; padding: 0 }
      html[data-embed="true"] .tool-workspace { margin: 0; border: 0; border-radius: 0; box-shadow: none }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="topbar">Free · private · no account required</div>
    <header class="header">
      <nav class="nav wrap" aria-label="Primary navigation">
        <a class="logo" href={path(lang)}><b>+</b>CalcWise</a>
        <div class="links">
          <a href={path(lang, 'tools')}>{u.all}</a>
          <a href={path(lang, 'collections')}>Collections</a>
          <a href={path(lang, 'about')}>About</a>
        </div>
        <label class="sr-only" for="language-switcher">{u.language}</label>
        <select id="language-switcher" class="lang" aria-label={u.language} onchange="location.href=this.value">
          {locales.map((locale) => <option value={switchPath(locale)} selected={locale === lang}>{localeNames[locale]}</option>)}
        </select>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="wrap footgrid">
        <div>
          <a class="logo" href={path(lang)}><b>+</b>CalcWise</a>
          <p>Original, formula-led calculators for everyday decisions.</p>
        </div>
        <div>
          <strong>Explore</strong>
          <a href={path(lang, 'tools')}>{u.all}</a>
          <a href={path(lang, 'collections')}>Collections</a>
          <a href={path(lang, 'embed')}>Embed a calculator</a>
          <a href={path(lang, 'methodology')}>Methodology</a>
          <a href={path(lang, 'editorial-policy')}>Editorial policy</a>
        </div>
        <div>
          <strong>Company</strong>
          <a href={path(lang, 'about')}>About</a>
          <a href={path(lang, 'contact')}>Contact</a>
          <a href={path(lang, 'privacy')}>Privacy</a>
          <a href={path(lang, 'terms')}>Terms</a>
          <a href={path(lang, 'cookies')}>Cookies</a>
          <a href={path(lang, 'disclaimer')}>Disclaimer</a>
        </div>
      </div>
    </footer>
    <div class="cookie" data-cookie role="dialog" aria-label="Cookie preferences">
      <p>We use optional advertising cookies only after consent. Calculator inputs never leave your browser.</p>
      <button class="btn primary" type="button" data-accept>Accept optional cookies</button>
      <button class="btn" type="button" data-reject>Reject</button>
    </div>
    <script is:inline>
      (() => {
        const box = document.querySelector('[data-cookie]');
        const consent = localStorage.getItem('consent');
        if (consent) box?.setAttribute('hidden', '');
        const setConsent = (value, granted) => {
          localStorage.setItem('consent', value);
          if (granted) window.gtag?.('consent', 'update', { ad_storage: 'granted', analytics_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted' });
          box?.setAttribute('hidden', '');
        };
        document.querySelector('[data-accept]')?.addEventListener('click', () => setConsent('yes', true));
        document.querySelector('[data-reject]')?.addEventListener('click', () => setConsent('no', false));
      })();
    </script>
  </body>
</html>
